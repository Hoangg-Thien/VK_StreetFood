@{
    ViewData["Title"] = "Quản lý địa điểm (POI)";
    Layout = "_AdminLayout";

    var pois = ViewBag.POIs as IEnumerable<VK.Core.Entities.PointOfInterest> ?? new List<VK.Core.Entities.PointOfInterest>();
    var categories = ViewBag.Categories as IEnumerable<VK.Core.Entities.Category> ?? new List<VK.Core.Entities.Category>();
    int total = ViewBag.Total ?? 0;
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
}

@if (TempData["Success"] != null)
{
    <div style="background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.2);border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#22C55E;font-size:13px;">
        <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#EF4444;font-size:13px;">
        <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
    </div>
}

<div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;">
    <div>
        <div class="page-title">Địa điểm (POI)</div>
        <div class="page-subtitle">Quản lý tất cả các điểm tham quan tại Vinh Khánh</div>
    </div>
    <button class="btn-primary-admin" onclick="openModal('addPoiModal')">
        <i class="fa-solid fa-plus"></i>
        Thêm địa điểm
    </button>
</div>

<!-- TABLE CARD -->
<div class="admin-card">
    <!-- FILTER BAR -->
    <form method="get" action="/Poi" class="filter-bar">
        <div class="search-input-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="search" placeholder="Tìm theo tên, địa chỉ..." value="@ViewBag.Search" />
        </div>
        <select name="categoryId">
            <option value="">Tất cả danh mục</option>
            @foreach (var cat in categories)
            {
                <option value="@cat.Id" selected="@(ViewBag.CategoryId?.ToString() == cat.Id.ToString() ? "selected" : null)">@cat.Name</option>
            }
        </select>
        <select name="isActive">
            <option value="">Tất cả trạng thái</option>
            <option value="true" selected="@(ViewBag.IsActive?.ToString() == "True" ? "selected" : null)">Hoạt động</option>
            <option value="false" selected="@(ViewBag.IsActive?.ToString() == "False" ? "selected" : null)">Tạm dừng</option>
        </select>
        <button type="submit" class="btn-primary-admin" style="padding:8px 14px;">
            <i class="fa-solid fa-filter"></i> Lọc
        </button>
        <a href="/Poi" class="btn-secondary-admin" style="padding:8px 14px;">
            <i class="fa-solid fa-rotate-right"></i> Đặt lại
        </a>
    </form>

    <!-- TABLE -->
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Địa điểm</th>
                    <th>Danh mục</th>
                    <th>Tọa độ</th>
                    <th>Audio</th>
                    <th>Đánh giá</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (pois.Any())
                {
                    @foreach (var poi in pois)
                    {
                        var initials = string.Join("", poi.Name.Split(' ').Where(w => w.Length > 0).Take(2).Select(w => w[0].ToString().ToUpper()));
                        var bgColors = new[] { "#E85D04", "#3B82F6", "#8B5CF6", "#22C55E", "#F59E0B" };
                        var bg = bgColors[Math.Abs(poi.Id.GetHashCode()) % bgColors.Length];
                        <tr>
                            <td>
                                <div class="item-info">
                                    <div class="table-avatar" style="background:@bg;">@initials</div>
                                    <div>
                                        <div class="item-name">@poi.Name</div>
                                        <div class="item-sub">@poi.Address</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (poi.Category != null)
                                {
                                    <span class="lang-badge lang-vi">@poi.Category.Name</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);font-size:12px;">—</span>
                                }
                            </td>
                            <td style="color:var(--text-muted);font-size:12px;">
                                @poi.Latitude.ToString("F4"), @poi.Longitude.ToString("F4")
                            </td>
                            <td>
                                <span style="font-size:12px;color:var(--accent-orange);">
                                    <i class="fa-solid fa-headphones"></i>
                                    @poi.AudioContents.Count
                                </span>
                            </td>
                            <td>
                                <span style="font-size:12px;color:var(--yellow);">
                                    <i class="fa-solid fa-star"></i>
                                    @poi.AverageRating.ToString("F1") (@poi.TotalRatings)
                                </span>
                            </td>
                            <td>
                                @if (poi.IsActive)
                                {
                                    <span class="badge-status badge-active">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inactive">Tạm dừng</span>
                                }
                            </td>
                            <td style="color:var(--text-muted);font-size:12px;">
                                @poi.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <div style="display:flex;gap:6px;">
                                    <button class="action-btn view" onclick="openEditModal(@poi.Id, '@poi.Name', '@poi.Description', '@poi.Address', @poi.Latitude, @poi.Longitude, @poi.IsActive.ToString().ToLower())" title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <form method="post" action="/Poi/ToggleActive" style="display:inline;">
                                        <input type="hidden" name="id" value="@poi.Id" />
                                        <button type="submit" class="action-btn" title="@(poi.IsActive ? "Tạm dừng" : "Kích hoạt")">
                                            <i class="fa-solid @(poi.IsActive ? "fa-pause" : "fa-play")"></i>
                                        </button>
                                    </form>
                                    <form method="post" action="/Poi/Delete" style="display:inline;" onsubmit="return confirm('Xóa địa điểm này?')">
                                        <input type="hidden" name="id" value="@poi.Id" />
                                        <button type="submit" class="action-btn delete" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <i class="fa-solid fa-map-location-dot"></i>
                                <p>Chưa có địa điểm nào. Hãy thêm địa điểm đầu tiên!</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    <div class="pagination-wrap">
        <span>Hiển thị @(((page - 1) * pageSize) + 1)–@(Math.Min(page * pageSize, total)) trong @total địa điểm</span>
        <div class="pagination-btns">
            @for (int i = 1; i <= Math.Ceiling((double)total / pageSize); i++)
            {
                <button class="@(i == page ? "active" : "")" onclick="location.href='/Poi?page=@i&search=@ViewBag.Search'">@i</button>
            }
        </div>
    </div>
</div>

<!-- ADD POI MODAL -->
<div class="modal-overlay" id="addPoiModal">
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-title"><i class="fa-solid fa-map-pin" style="color:var(--accent-orange);margin-right:8px;"></i>Thêm địa điểm mới</span>
            <button class="modal-close" onclick="closeModal('addPoiModal')"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="/Poi/Create">
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Tên địa điểm *</label>
                    <input type="text" name="Name" class="form-control-admin" placeholder="VD: Bún Thịt Nướng Kim..." required />
                </div>
                <div class="form-group">
                    <label class="form-label">Mô tả</label>
                    <textarea name="Description" class="form-control-admin" rows="3" placeholder="Mô tả ngắn về địa điểm..."></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Địa chỉ *</label>
                    <input type="text" name="Address" class="form-control-admin" placeholder="Số nhà, đường, phường..." required />
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="form-group">
                        <label class="form-label">Vĩ độ (Latitude) *</label>
                        <input type="number" name="Latitude" step="0.000001" class="form-control-admin" placeholder="10.0452..." required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Kinh độ (Longitude) *</label>
                        <input type="number" name="Longitude" step="0.000001" class="form-control-admin" placeholder="105.7469..." required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Danh mục</label>
                    <select name="CategoryId" class="form-control-admin">
                        <option value="">-- Chọn danh mục --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Ảnh (URL)</label>
                    <input type="text" name="ImageUrl" class="form-control-admin" placeholder="https://..." />
                </div>
                <div class="form-group" style="display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" name="IsActive" value="true" checked id="isActiveAdd" style="width:16px;height:16px;accent-color:var(--accent-orange);" />
                    <label for="isActiveAdd" style="font-size:13px;color:var(--text-secondary);cursor:pointer;">Kích hoạt ngay</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" onclick="closeModal('addPoiModal')">Hủy</button>
                <button type="submit" class="btn-primary-admin"><i class="fa-solid fa-floppy-disk"></i> Lưu địa điểm</button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT POI MODAL -->
<div class="modal-overlay" id="editPoiModal">
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-title"><i class="fa-solid fa-pen" style="color:var(--blue);margin-right:8px;"></i>Chỉnh sửa địa điểm</span>
            <button class="modal-close" onclick="closeModal('editPoiModal')"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="/Poi/Edit">
            <div class="modal-body">
                <input type="hidden" name="Id" id="editPoiId" />
                <div class="form-group">
                    <label class="form-label">Tên địa điểm *</label>
                    <input type="text" name="Name" id="editPoiName" class="form-control-admin" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Mô tả</label>
                    <textarea name="Description" id="editPoiDesc" class="form-control-admin" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Địa chỉ</label>
                    <input type="text" name="Address" id="editPoiAddr" class="form-control-admin" />
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="form-group">
                        <label class="form-label">Vĩ độ</label>
                        <input type="number" name="Latitude" id="editPoiLat" step="0.000001" class="form-control-admin" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Kinh độ</label>
                        <input type="number" name="Longitude" id="editPoiLng" step="0.000001" class="form-control-admin" />
                    </div>
                </div>
                <div class="form-group" style="display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" name="IsActive" value="true" id="editIsActive" style="width:16px;height:16px;accent-color:var(--accent-orange);" />
                    <label for="editIsActive" style="font-size:13px;color:var(--text-secondary);cursor:pointer;">Đang hoạt động</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" onclick="closeModal('editPoiModal')">Hủy</button>
                <button type="submit" class="btn-primary-admin"><i class="fa-solid fa-floppy-disk"></i> Cập nhật</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function openEditModal(id, name, desc, addr, lat, lng, isActive) {
    document.getElementById('editPoiId').value = id;
    document.getElementById('editPoiName').value = name;
    document.getElementById('editPoiDesc').value = desc;
    document.getElementById('editPoiAddr').value = addr;
    document.getElementById('editPoiLat').value = lat;
    document.getElementById('editPoiLng').value = lng;
    document.getElementById('editIsActive').checked = isActive === 'true';
    openModal('editPoiModal');
}
</script>
}
