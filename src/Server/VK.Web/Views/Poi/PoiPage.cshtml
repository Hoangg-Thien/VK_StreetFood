@{
    bool isOwner = ViewBag.IsOwner ?? false;
    ViewData["Title"] = isOwner ? "Quán của tôi" : "Quản lý địa điểm (POI)";
    Layout = isOwner ? "_OwnerLayout" : "_AdminLayout";

    var pois = ViewBag.POIs as IEnumerable<VK.Core.Entities.PointOfInterest> ?? new
List<VK.Core.Entities.PointOfInterest>();
    var categories = ViewBag.Categories as IEnumerable<VK.Core.Entities.Category> ?? new List<VK.Core.Entities.Category>();
    int total = ViewBag.Total ?? 0;
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
}

@if (TempData["Success"] != null)
{
    <div
        style="background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.2);border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#22C55E;font-size:13px;">
        <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div
        style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#EF4444;font-size:13px;">
        <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
    </div>
}

<div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;">
    <div>
        <div class="page-title">@(isOwner ? "Quán của tôi" : "Địa điểm (POI)")</div>
        <div class="page-subtitle">@(isOwner ? "Quản lý quán của bạn" : "Quản lý tất cả các điểm tham quan tại Vĩnh Khánh")</div>
    </div>
    @if (!isOwner)
    {
        <button class="btn-primary-admin" onclick="openAddPoiModal()">
            <i class="fa-solid fa-plus"></i>
            Thêm địa điểm
        </button>
    }
</div>

<!-- TABLE CARD -->
<div class="admin-card">
    <!-- FILTER BAR -->
    <form method="get" action="/Poi" class="filter-bar">
        <div class="search-input-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="search" placeholder="Tìm theo tên, địa chỉ..." value="@ViewBag.Search" />
        </div>
        <select name="categoryId">
            <option value="">Tất cả danh mục</option>
            @foreach (var cat in categories)
            {
                <option value="@cat.Id"
                        selected="@(ViewBag.CategoryId?.ToString() == cat.Id.ToString() ? "selected" : null)">@cat.Name</option>
            }
        </select>
        <select name="isActive">
            <option value="">Tất cả trạng thái</option>
            <option value="true" selected="@(ViewBag.IsActive?.ToString() == "True" ? "selected" : null)">Hoạt động
            </option>
            <option value="false" selected="@(ViewBag.IsActive?.ToString() == "False" ? "selected" : null)">Tạm dừng
            </option>
        </select>
        <button type="submit" class="btn-primary-admin" style="padding:8px 14px;">
            <i class="fa-solid fa-filter"></i> Lọc
        </button>
        <a href="/Poi" class="btn-secondary-admin" style="padding:8px 14px;">
            <i class="fa-solid fa-rotate-right"></i> Đặt lại
        </a>
    </form>

    <!-- TABLE -->
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Địa điểm</th>
                    <th>Danh mục</th>
                    <th>Tọa độ</th>
                    <th>Audio</th>
                    <th>QR</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (pois.Any())
                {
                    @foreach (var poi in pois)
                    {
                        var initials = string.Join("", poi.Name.Split(' ').Where(w => w.Length > 0).Take(2).Select(w =>
                w[0].ToString().ToUpper()));
                        var bgColors = new[] { "#E85D04", "#3B82F6", "#8B5CF6", "#22C55E", "#F59E0B" };
                        var bg = bgColors[Math.Abs(poi.Id.GetHashCode()) % bgColors.Length];
                        var apiBase = "http://localhost:5089";
                        var qrTargetUrl = $"vkstreetfood://poi/{poi.Id}?autoplay=1";
                        var qrImageUrl = "https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=" +
                Uri.EscapeDataString(qrTargetUrl);
                        var qrFileName = $"poi-{poi.Id}-qr.png";
                        <tr>
                            <td>
                                <div class="item-info">
                                    @if (!string.IsNullOrEmpty(poi.ImageUrl))
                                    {
                                        var imgSrc = poi.ImageUrl.StartsWith("http") ? poi.ImageUrl : apiBase + poi.ImageUrl;
                                        <img src="@imgSrc" class="table-avatar" style="object-fit:cover;border-radius:8px;"
                                             alt="@poi.Name"
                                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                        <div class="table-avatar" style="background:@bg;display:none;">@initials</div>
                                    }
                                    else
                                    {
                                        <div class="table-avatar" style="background:@bg;">@initials</div>
                                    }
                                    <div>
                                        <div class="item-name">@poi.Name</div>
                                        <div class="item-sub">@poi.Address</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (poi.Category != null)
                                {
                                    <span class="lang-badge lang-vi">@poi.Category.Name</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);font-size:12px;">—</span>
                                }
                            </td>
                            <td style="color:var(--text-muted);font-size:12px;">
                                @poi.Latitude.ToString("F4"), @poi.Longitude.ToString("F4")
                            </td>
                            <td>
                                <span style="font-size:12px;color:var(--accent-orange);">
                                    <i class="fa-solid fa-headphones"></i>
                                    @poi.AudioContents.Count
                                </span>
                            </td>
                            <td>
                                <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                    <img src="@qrImageUrl" alt="QR @poi.Name" title="Quét để mở app vào POI này"
                                         style="width:68px;height:68px;padding:4px;border-radius:8px;border:1px solid var(--border);background:#fff;object-fit:contain;" />
                                    <a href="@qrImageUrl"
                                       download="@qrFileName"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       style="font-size:11px;color:var(--accent-orange);text-decoration:none;font-weight:600;">
                                        <i class="fa-solid fa-download"></i> Tải QR
                                    </a>
                                    <span style="font-size:11px;color:var(--text-muted);">POI #@poi.Id</span>
                                </div>
                            </td>
                            <td>
                                @if (poi.IsActive)
                                {
                                    <span class="badge-status badge-active">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inactive">Tạm dừng</span>
                                }
                            </td>
                            <td>
                                <div style="display:flex;gap:6px;">
                                    <button class="action-btn edit"
                                            onclick='openEditModal(@poi.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(poi.Name)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(poi.Description)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(poi.Address)), @poi.Latitude, @poi.Longitude, "@poi.IsActive.ToString().ToLower()", @(poi.CategoryId.HasValue ? poi.CategoryId.ToString() : "null"), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(poi.ImageUrl ?? "")))'
                                            title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    @if (!isOwner)
                                    {
                                        <form method="post" action="/Poi/ToggleActive" style="display:inline;">
                                            <input type="hidden" name="id" value="@poi.Id" />
                                            <button type="submit" class="action-btn"
                                                    title="@(poi.IsActive ? "Tạm dừng" : "Kích hoạt")">
                                                <i class="fa-solid @(poi.IsActive ? "fa-pause" : "fa-play")"></i>
                                            </button>
                                        </form>
                                        <form method="post" action="/Poi/Delete" style="display:inline;"
                                              onsubmit="return confirm('Xóa địa điểm này?')">
                                            <input type="hidden" name="id" value="@poi.Id" />
                                            <button type="submit" class="action-btn delete" title="Xóa">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <i class="fa-solid fa-map-location-dot"></i>
                                <p>Chưa có địa điểm nào. Hãy thêm địa điểm đầu tiên!</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    <div class="pagination-wrap">
        <span>Hiển thị @(((page - 1) * pageSize) + 1)–@(Math.Min(page * pageSize, total)) trong @total địa điểm</span>
        <div class="pagination-btns">
            @for (int i = 1; i <= Math.Ceiling((double)total / pageSize); i++)
            {
                <button class="@(i == page ? "active" : "")"
                        onclick="location.href='/Poi?page=@i&search=@ViewBag.Search'">@i</button>
            }
        </div>
    </div>
</div>

@if (!isOwner)
{
    <!-- ADD POI MODAL -->
    <div class="modal-overlay" id="addPoiModal">
        <div class="modal-box">
            <div class="modal-header">
                <span class="modal-title"><i class="fa-solid fa-map-pin"
                                                 style="color:var(--accent-orange);margin-right:8px;"></i>Thêm địa điểm mới</span>
                    <button class="modal-close" onclick="closeModal('addPoiModal')"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <form method="post" action="/Poi/Create" id="addPoiForm" onsubmit="return false;">
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="form-label">Tên địa điểm *</label>
                            <input type="text" name="Name" class="form-control-admin" placeholder="VD: Bún Thịt Nướng Kim..."
                                   required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Mô tả</label>
                            <textarea name="Description" class="form-control-admin" rows="3"
                                      placeholder="Mô tả ngắn về địa điểm..."></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Địa chỉ *</label>
                            <input type="text" name="Address" class="form-control-admin" placeholder="Số nhà, đường, phường..."
                                   required />
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                            <div class="form-group">
                                <label class="form-label">Vĩ độ (Latitude) *</label>
                                <input type="number" name="Latitude" step="0.000001" class="form-control-admin"
                                       placeholder="10.0452..." required />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Kinh độ (Longitude) *</label>
                                <input type="number" name="Longitude" step="0.000001" class="form-control-admin"
                                       placeholder="105.7469..." required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Danh mục</label>
                            <select name="CategoryId" class="form-control-admin">
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Ảnh địa điểm</label>
                            <div id="addImgPreviewWrap" style="margin-bottom:10px;display:none;">
                                <img id="addImgPreview" src="" alt="preview"
                                     style="width:100%;max-height:180px;object-fit:cover;border-radius:10px;border:1px solid var(--border);" />
                            </div>
                            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:8px;">
                                <span
                                    style="background:var(--accent-orange);color:#fff;border-radius:6px;padding:6px 14px;font-size:12px;font-weight:600;">
                                    <i class="fa-solid fa-upload"></i> Tải ảnh lên
                                </span>
                                <span id="addImgFileName" style="font-size:12px;color:var(--text-muted);">Chưa chọn file</span>
                                <input type="file" id="addImgFile" accept="image/*" style="display:none;"
                                       onchange="handleAddImgFile(this)" />
                            </label>
                            <input type="hidden" name="ImageUrl" id="addPoiImageUrl" />
                            <input type="text" id="addPoiImageUrlText" class="form-control-admin"
                                   placeholder="URL ảnh: /images/poi/ten-anh.jpg" oninput="syncAddImgUrl(this.value)"
                                   style="margin-top:4px;" />
                        </div>
                        <div class="form-group" style="display:flex;align-items:center;gap:10px;">
                            <input type="checkbox" name="IsActive" value="true" checked id="isActiveAdd"
                                   style="width:16px;height:16px;accent-color:var(--accent-orange);" />
                            <label for="isActiveAdd" style="font-size:13px;color:var(--text-secondary);cursor:pointer;">Kích
                                hoạt ngay</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn-secondary-admin" onclick="closeModal('addPoiModal')">Hủy</button>
                            <button type="button" class="btn-primary-admin" onclick="submitAddForm(this)"><i
                                class="fa-solid fa-floppy-disk"></i> Lưu địa điểm</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <!-- EDIT POI MODAL -->
            <div class="modal-overlay" id="editPoiModal">
                <div class="modal-box">
                    <div class="modal-header">
                        <span class="modal-title">Chỉnh sửa địa điểm</span>
                        <button class="modal-close" onclick="closeModal('editPoiModal')"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                    <form method="post" action="/Poi/Edit" id="editPoiForm" onsubmit="return false;">
                        <div class="modal-body">
                            <input type="hidden" name="Id" id="editPoiId" />
                            <div class="form-group">
                                <label class="form-label">Tên địa điểm *</label>
                                <input type="text" name="Name" id="editPoiName" class="form-control-admin" required />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Mô tả</label>
                                <textarea name="Description" id="editPoiDesc" class="form-control-admin" rows="3"></textarea>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Địa chỉ</label>
                                <input type="text" name="Address" id="editPoiAddr" class="form-control-admin" />
                            </div>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                                <div class="form-group">
                                    <label class="form-label">Vĩ độ</label>
                                    <input type="number" name="Latitude" id="editPoiLat" step="0.000001"
                                           class="form-control-admin" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Kinh độ</label>
                                    <input type="number" name="Longitude" id="editPoiLng" step="0.000001"
                                           class="form-control-admin" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Danh mục</label>
                                <select name="CategoryId" id="editPoiCategory" class="form-control-admin">
                                    <option value="">-- Chọn danh mục --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Ảnh địa điểm</label>
                                <!-- Preview -->
                                <div id="editImgPreviewWrap" style="margin-bottom:10px;display:none;">
                                    <img id="editImgPreview" src="" alt="preview"
                                         style="width:100%;max-height:180px;object-fit:cover;border-radius:10px;border:1px solid var(--border);" />
                                </div>
                                <!-- Upload file -->
                                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:8px;">
                                    <span
                                        style="background:var(--accent-orange);color:#fff;border-radius:6px;padding:6px 14px;font-size:12px;font-weight:600;">
                                        <i class="fa-solid fa-upload"></i> Tải ảnh lên
                                    </span>
                                    <span id="editImgFileName" style="font-size:12px;color:var(--text-muted);">Chưa chọn file</span>
                                    <input type="file" id="editImgFile" accept="image/*" style="display:none;"
                                           onchange="handleEditImgFile(this)" />
                                </label>
                                <!-- Hidden: stores final path/url to submit -->
                                <input type="hidden" name="ImageUrl" id="editPoiImageUrl" />
                                <!-- Manual URL fallback -->
                                <input type="text" id="editPoiImageUrlText" class="form-control-admin"
                                       placeholder="Hoặc dán URL ảnh: /images/poi/ten-anh.jpg" oninput="syncEditImgUrl(this.value)"
                                       style="margin-top:4px;" />
                            </div>
                            <div class="form-group" style="display:flex;align-items:center;gap:10px;">
                                <input type="checkbox" name="IsActive" value="true" id="editIsActive"
                                       style="width:16px;height:16px;accent-color:var(--accent-orange);" />
                                <label for="editIsActive" style="font-size:13px;color:var(--text-secondary);cursor:pointer;">Đang
                                    hoạt động</label>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-secondary-admin" onclick="closeModal('editPoiModal')">Hủy</button>
                                <button type="button" class="btn-primary-admin" onclick="submitEditForm(this)">
                                    <i class="fa-solid fa-floppy-disk"></i> @(isOwner ? "Gửi duyệt chỉnh sửa" : "Cập nhật")
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                @section Scripts {
                    <script>
                        var _pendingImgFile = null; // file chờ upload khi bấm Cập nhật
                        var _pendingAddImgFile = null;

                        function showAddPreview(url) {
                            var wrap = document.getElementById('addImgPreviewWrap');
                            var img = document.getElementById('addImgPreview');
                            if (!wrap || !img) return;

                            if (url) {
                                var src = url.startsWith('http') ? url : 'http://localhost:5089' + url;
                                img.src = src;
                                wrap.style.display = 'block';
                            } else {
                                wrap.style.display = 'none';
                                img.src = '';
                            }
                        }

                        function syncAddImgUrl(val) {
                            _pendingAddImgFile = null;
                            var fileInput = document.getElementById('addImgFile');
                            if (fileInput) {
                                fileInput.value = '';
                            }

                            var fileName = document.getElementById('addImgFileName');
                            if (fileName) {
                                fileName.textContent = 'Chưa chọn file';
                            }

                            var hidden = document.getElementById('addPoiImageUrl');
                            if (hidden) {
                                hidden.value = val;
                            }

                            showAddPreview(val);
                        }

                        function handleAddImgFile(input) {
                            if (!input.files || !input.files[0]) return;

                            var file = input.files[0];
                            _pendingAddImgFile = file;
                            document.getElementById('addImgFileName').textContent = file.name;

                            var reader = new FileReader();
                            reader.onload = function (e) {
                                var wrap = document.getElementById('addImgPreviewWrap');
                                var img = document.getElementById('addImgPreview');
                                img.src = e.target.result;
                                wrap.style.display = 'block';
                            };
                            reader.readAsDataURL(file);

                            document.getElementById('addPoiImageUrlText').value = '';
                            document.getElementById('addPoiImageUrl').value = '';
                        }

                        function submitAddForm(btn) {
                            btn.disabled = true;
                            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang lưu...';

                            if (_pendingAddImgFile) {
                                var formData = new FormData();
                                formData.append('file', _pendingAddImgFile);
                                fetch('/Poi/UploadImage', { method: 'POST', body: formData })
                                    .then(function (r) { return r.json(); })
                                    .then(function (data) {
                                        if (data.url) {
                                            document.getElementById('addPoiImageUrl').value = data.url;
                                        }
                                        document.getElementById('addPoiForm').submit();
                                    })
                                    .catch(function () {
                                        btn.disabled = false;
                                        btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Lưu địa điểm';
                                        alert('Upload ảnh thất bại. Vui lòng thử lại hoặc dán URL thủ công.');
                                    });
                            } else {
                                document.getElementById('addPoiForm').submit();
                            }
                        }

                        function openAddPoiModal() {
                            _pendingAddImgFile = null;

                            var form = document.getElementById('addPoiForm');
                            if (form) {
                                form.reset();
                            }

                            var fileName = document.getElementById('addImgFileName');
                            if (fileName) {
                                fileName.textContent = 'Chưa chọn file';
                            }

                            var hidden = document.getElementById('addPoiImageUrl');
                            if (hidden) {
                                hidden.value = '';
                            }

                            showAddPreview('');
                            openModal('addPoiModal');
                        }

                        function openEditModal(id, name, desc, addr, lat, lng, isActive, categoryId, imageUrl) {
                            document.getElementById('editPoiId').value = id;
                            document.getElementById('editPoiName').value = name;
                            document.getElementById('editPoiDesc').value = desc;
                            document.getElementById('editPoiAddr').value = addr;
                            document.getElementById('editPoiLat').value = lat;
                            document.getElementById('editPoiLng').value = lng;
                            document.getElementById('editIsActive').checked = isActive === 'true';
                            document.getElementById('editPoiCategory').value = categoryId ?? '';

                            // Reset file input và pending file
                            _pendingImgFile = null;
                            document.getElementById('editImgFile').value = '';
                            document.getElementById('editImgFileName').textContent = 'Chưa chọn file';

                            // Set image URL và hiện preview ảnh hiện tại
                            var url = imageUrl || '';
                            document.getElementById('editPoiImageUrl').value = url;
                            document.getElementById('editPoiImageUrlText').value = url;
                            showEditPreview(url);

                            openModal('editPoiModal');
                        }

                        function showEditPreview(url) {
                            var wrap = document.getElementById('editImgPreviewWrap');
                            var img = document.getElementById('editImgPreview');
                            if (url) {
                                var src = url.startsWith('http') ? url : 'http://localhost:5089' + url;
                                img.src = src;
                                wrap.style.display = 'block';
                            } else {
                                wrap.style.display = 'none';
                                img.src = '';
                            }
                        }

                        function syncEditImgUrl(val) {
                            _pendingImgFile = null; // URL nhập tay → bỏ file đang chờ
                            document.getElementById('editImgFileName').textContent = 'Chưa chọn file';
                            document.getElementById('editImgFile').value = '';
                            document.getElementById('editPoiImageUrl').value = val;
                            showEditPreview(val);
                        }

                        function handleEditImgFile(input) {
                            if (!input.files || !input.files[0]) return;
                            var file = input.files[0];
                            _pendingImgFile = file; // lưu file, chưa upload
                            document.getElementById('editImgFileName').textContent = file.name;

                            // Chỉ preview local — chưa upload lên server
                            var reader = new FileReader();
                            reader.onload = function (e) {
                                var wrap = document.getElementById('editImgPreviewWrap');
                                var img = document.getElementById('editImgPreview');
                                img.src = e.target.result;
                                wrap.style.display = 'block';
                            };
                            reader.readAsDataURL(file);
                            // Xóa URL text vì đang dùng file mới
                            document.getElementById('editPoiImageUrlText').value = '';
                            document.getElementById('editPoiImageUrl').value = '';
                        }

                        function submitEditForm(btn) {
                            btn.disabled = true;
                            btn.innerHTML = @(isOwner
                                            ? Html.Raw("'<i class=\"fa-solid fa-spinner fa-spin\"></i> Đang gửi duyệt...'")
                                        : Html.Raw("'<i class=\"fa-solid fa-spinner fa-spin\"></i> Đang lưu...'")
                                        );

                            if (_pendingImgFile) {
                                // Upload file trước, sau đó submit form
                                var formData = new FormData();
                                formData.append('file', _pendingImgFile);
                                fetch('/Poi/UploadImage', { method: 'POST', body: formData })
                                    .then(function (r) { return r.json(); })
                                    .then(function (data) {
                                        if (data.url) {
                                            document.getElementById('editPoiImageUrl').value = data.url;
                                        }
                                        document.getElementById('editPoiForm').submit();
                                    })
                                    .catch(function () {
                                        btn.disabled = false;
                                        btn.innerHTML = @(isOwner
                                                                    ? Html.Raw("'<i class=\"fa-solid fa-floppy-disk\"></i> Gửi duyệt chỉnh sửa'")
                                                                : Html.Raw("'<i class=\"fa-solid fa-floppy-disk\"></i> Cập nhật'")
                                                                );
                                        alert('Upload ảnh thất bại. Vui lòng thử lại hoặc dán URL thủ công.');
                                    });
                            } else {
                                document.getElementById('editPoiForm').submit();
                            }
                        }
                    </script>
                }
