@{
    ViewData["Title"] = "Lịch sử sử dụng";
    Layout = "_AdminLayout";

    var logs = ViewBag.Logs as IEnumerable<VK.Core.Entities.VisitLog> ?? new List<VK.Core.Entities.VisitLog>();
    var topListened = ViewBag.TopListened as IEnumerable<VK.Web.Controllers.UsageHistoryController.TopListenedPoiVm>
        ?? new List<VK.Web.Controllers.UsageHistoryController.TopListenedPoiVm>();
    var avgListen = ViewBag.AvgListen as IEnumerable<VK.Web.Controllers.UsageHistoryController.AverageListenPoiVm>
        ?? new List<VK.Web.Controllers.UsageHistoryController.AverageListenPoiVm>();
    var heatmap = ViewBag.Heatmap as IEnumerable<VK.Web.Controllers.UsageHistoryController.HeatmapPointVm>
        ?? new List<VK.Web.Controllers.UsageHistoryController.HeatmapPointVm>();
    var anonymousRoutes = ViewBag.AnonymousRoutes as IEnumerable<VK.Web.Controllers.UsageHistoryController.AnonymousRouteVm>
        ?? new List<VK.Web.Controllers.UsageHistoryController.AnonymousRouteVm>();

    int total = ViewBag.Total ?? 0;
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 15;
    int audioPlayedCount = ViewBag.AudioPlayedCount ?? 0;
    int distinctLanguageCount = ViewBag.DistinctLanguageCount ?? 0;
    int distinctPoiCount = ViewBag.DistinctPoiCount ?? 0;

    string? selectedLanguage = ViewBag.Language as string;
    int? selectedPoiId = ViewBag.PoiId as int?;
    string? fromDateValue = ViewBag.FromDate as string;
    string? toDateValue = ViewBag.ToDate as string;

    string BuildPageUrl(int targetPage)
    {
        var query = new List<string> { $"page={targetPage}" };
        if (!string.IsNullOrWhiteSpace(selectedLanguage))
            query.Add($"language={Uri.EscapeDataString(selectedLanguage)}");
        if (selectedPoiId.HasValue)
            query.Add($"poiId={selectedPoiId.Value}");
        if (!string.IsNullOrWhiteSpace(fromDateValue))
            query.Add($"fromDate={Uri.EscapeDataString(fromDateValue)}");
        if (!string.IsNullOrWhiteSpace(toDateValue))
            query.Add($"toDate={Uri.EscapeDataString(toDateValue)}");
        return "/UsageHistory?" + string.Join("&", query);
    }

    var langMap = new Dictionary<string, (string flag, string css)>
    {
        ["vi"] = ("🇻🇳", "lang-vi"),
        ["en"] = ("🇺🇸", "lang-en"),
        ["ko"] = ("🇰🇷", "lang-ko"),
    };
}

<div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;">
    <div>
        <div class="page-title">Lịch sử sử dụng</div>
        <div class="page-subtitle">Theo dõi toàn bộ lượt tham quan và tương tác của du khách</div>
    </div>
</div>

<!-- STAT CARDS -->
<div class="stat-cards" style="grid-template-columns:repeat(4,1fr);">
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-icon orange"><i class="fa-solid fa-person-walking"></i></div>
        </div>
        <div class="stat-value">@total</div>
        <div class="stat-label">Tổng lượt tham quan</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-icon blue"><i class="fa-solid fa-headphones"></i></div>
        </div>
        <div class="stat-value">@audioPlayedCount</div>
        <div class="stat-label">Lượt phát audio</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-icon green"><i class="fa-solid fa-globe"></i></div>
            </div>
            <div class="stat-value">@distinctLanguageCount</div>
            <div class="stat-label">Ngôn ngữ sử dụng</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-icon purple"><i class="fa-solid fa-map-pin"></i></div>
            </div>
            <div class="stat-value">@distinctPoiCount</div>
            <div class="stat-label">Địa điểm được ghé thăm</div>
        </div>
    </div>

    <!-- ANALYTICS (REST API) -->
    <div class="grid-2-1" style="margin-bottom:24px;grid-template-columns:repeat(2,1fr);">
        <div class="admin-card">
            <div class="admin-card-header">
                <div class="admin-card-title">Top địa điểm được nghe nhiều nhất</div>
            </div>
            <div class="admin-card-body" style="padding-top:0;">
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>POI</th>
                                <th>Lượt nghe</th>
                                <th>Khách nghe</th>
                                <th>Hoàn tất</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (topListened.Any())
                            {
                                @foreach (var item in topListened)
                                {
                                    <tr>
                                        <td>@item.PoiName</td>
                                        <td>@item.AudioPlayCount</td>
                                        <td>@item.UniqueListeners</td>
                                        <td>@item.AudioCompleteCount</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" style="text-align:center;color:var(--text-muted);">Chưa có dữ liệu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-card-header">
                <div class="admin-card-title">Thời gian trung bình nghe 1 POI</div>
            </div>
            <div class="admin-card-body" style="padding-top:0;">
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>POI</th>
                                <th>Trung bình</th>
                                <th>Mẫu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (avgListen.Any())
                            {
                                @foreach (var item in avgListen)
                                {
                                    <tr>
                                        <td>@item.PoiName</td>
                                        <td>@TimeSpan.FromSeconds(item.AverageDurationSeconds).ToString("mm\\:ss")</td>
                                        <td>@item.SampleCount</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" style="text-align:center;color:var(--text-muted);">Chưa có dữ liệu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="grid-2-1" style="margin-bottom:24px;grid-template-columns:repeat(2,1fr);">
        <div class="admin-card">
            <div class="admin-card-header">
                <div>
                    <div class="admin-card-title">Heatmap vị trí người dùng</div>
                </div>
            </div>
            <div class="admin-card-body" style="padding-top:0;">
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Lat</th>
                                <th>Lng</th>
                                <th>Mật độ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (heatmap.Any())
                            {
                                @foreach (var point in heatmap.Take(15))
                                {
                                    <tr>
                                        <td>@point.Latitude</td>
                                        <td>@point.Longitude</td>
                                        <td>@point.Weight</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" style="text-align:center;color:var(--text-muted);">Chưa có dữ liệu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-card-header">
                <div>
                    <div class="admin-card-title">Lưu tuyến di chuyển (ẩn danh)</div>
                </div>
            </div>
            <div class="admin-card-body" style="padding-top:0;">
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Visitor</th>
                                <th>Số điểm</th>
                                <th>Khoảng thời gian</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (anonymousRoutes.Any())
                            {
                                @foreach (var route in anonymousRoutes.Take(15))
                                {
                                    <tr>
                                        <td><span style="font-family:monospace;">@route.AnonymousVisitorId</span></td>
                                        <td>@route.PointCount</td>
                                        <td>@route.FirstSeenAt.ToLocalTime().ToString("dd/MM HH:mm") -
                                            @route.LastSeenAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                        </tr>
                                    }
                                }
                        else
                                {
                                    <tr>
                                        <td colspan="3" style="text-align:center;color:var(--text-muted);">Chưa có dữ liệu</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- CHART + LANG DIST -->
        <div class="grid-2-1" style="margin-bottom:24px;">
            <div class="admin-card">
                <div class="admin-card-header">
                    <div>
                        <div class="admin-card-title">Lượt tham quan 7 ngày qua</div>
                        <div class="admin-card-subtitle">Biểu đồ theo ngày</div>
                    </div>
                </div>
                <div class="admin-card-body">
                    <div class="chart-container"><canvas id="visitsChart7d"></canvas></div>
                </div>
            </div>
            <div class="admin-card">
                <div class="admin-card-header">
                    <div class="admin-card-title">Phân bổ ngôn ngữ</div>
                </div>
                <div class="admin-card-body">
                    <div style="height:120px;display:flex;align-items:center;justify-content:center;">
                        <canvas id="langChart" style="max-height:120px;"></canvas>
                    </div>
                    @if (ViewBag.LangStats != null)
                    {
                        <div style="margin-top:16px;">
                            @foreach (var stat in (IEnumerable<dynamic>)ViewBag.LangStats)
                            {
                                var lCode = (string)stat.Language ?? "vi";
                                var (flag, css) = langMap.ContainsKey(lCode) ? langMap[lCode] : ("🌐", "lang-en");
                                <div
                                    style="display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border-color);">
                                    <span class="lang-badge @css" style="font-size:12px;">@flag @lCode.ToUpper()</span>
                                    <span style="font-size:13px;font-weight:600;">@stat.Count</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- LOGS TABLE -->
        <div class="admin-card">
            <form method="get" action="/UsageHistory" class="filter-bar">
                <select name="language">
                    <option value="">Tất cả ngôn ngữ</option>
                    <option value="vi" selected="@(selectedLanguage == "vi" ? "selected" : null)">🇻🇳 Tiếng Việt</option>
                    <option value="en" selected="@(selectedLanguage == "en" ? "selected" : null)">🇺🇸 English</option>
                    <option value="ko" selected="@(selectedLanguage == "ko" ? "selected" : null)">🇰🇷 한국어</option>
                </select>
                <select name="poiId">
                    <option value="">Tất cả địa điểm</option>
                    @foreach (var poi in (IEnumerable<dynamic>)ViewBag.POIs)
                    {
                        var id = (int)poi.Id;
                        <option value="@id" selected="@(selectedPoiId == id ? "selected" : null)">@poi.Name</option>
                    }
                </select>
                <input type="date" name="fromDate" class="form-control-admin" style="width:auto;padding:8px 12px;"
                       value="@fromDateValue" placeholder="Từ ngày" />
                <input type="date" name="toDate" class="form-control-admin" style="width:auto;padding:8px 12px;"
                       value="@toDateValue" placeholder="Đến ngày" />
                <button type="submit" class="btn-primary-admin" style="padding:8px 14px;"><i class="fa-solid fa-filter"></i>
                    Lọc</button>
                    <a href="/UsageHistory" class="btn-secondary-admin" style="padding:8px 14px;"><i
                        class="fa-solid fa-rotate-right"></i></a>
                    </form>

                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Du khách (Device ID)</th>
                                    <th>Địa điểm</th>
                                    <th>Ngôn ngữ</th>
                                    <th>Thời gian</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (logs.Any())
                                {
                                    int rowNum = (page - 1) * pageSize;
                                    @foreach (var log in logs)
                                    {
                                        rowNum++;
                                        var lCode = log.LanguageUsed ?? "vi";
                                        var (flag, css) = langMap.ContainsKey(lCode) ? langMap[lCode] : ("🌐", "lang-en");
                                        var deviceShort = log.Tourist?.DeviceId?.Length > 12 ? log.Tourist.DeviceId[..12] + "..." :
                                (log.Tourist?.DeviceId ?? "—");
                                        <tr>
                                            <td style="color:var(--text-muted);font-size:12px;">@rowNum</td>
                                            <td>
                                                <div class="item-info">
                                                    <div class="stat-icon blue"
                                                         style="width:30px;height:30px;border-radius:6px;font-size:12px;">
                                                        <i class="fa-solid fa-mobile-screen"></i>
                                                    </div>
                                                    <span
                                                    style="font-size:12px;font-family:monospace;color:var(--text-secondary);">@deviceShort</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span style="font-size:13px;font-weight:500;">@(log.PointOfInterest?.Name ?? "—")</span>
                                            </td>
                                            <td><span class="lang-badge @css">@flag @lCode.ToUpper()</span></td>
                                            <td style="color:var(--text-muted);font-size:12px;">
                                                @log.VisitedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5">
                                            <div class="empty-state">
                                                <i class="fa-solid fa-clock-rotate-left"></i>
                                                <p>Chưa có lịch sử sử dụng nào.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination-wrap">
                        <span>Hiển thị @(Math.Min(total, page * pageSize)) trong @total lượt</span>
                        <div class="pagination-btns">
                            @for (int i = 1; i <= Math.Max(1, (int)Math.Ceiling((double)total / pageSize)); i++)
                            {
                                <button class="@(i == page ? "active" : "")" onclick="location.href='@BuildPageUrl(i)'">@i</button>
                            }
                        </div>
                    </div>
                </div>

                @section Scripts {
                    <script>
                        // 7-day visits chart
                        const ctx7 = document.getElementById('visitsChart7d').getContext('2d');
                        const g7 = ctx7.createLinearGradient(0, 0, 0, 200);
                        g7.addColorStop(0, 'rgba(232,93,4,0.3)');
                        g7.addColorStop(1, 'rgba(232,93,4,0.02)');

                        const dailyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                                                                                                                                            (ViewBag.DailyVisits as IEnumerable<dynamic> ?? new List<dynamic>())
                                                                                                                                                                                                                                            .Select(d => (int)d.Count).ToList()
                                    ));
                        const dailyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                                                                                                                                            (ViewBag.DailyVisits as IEnumerable<dynamic> ?? new List<dynamic>())
                                                                                                                                                                                                                                            .Select(d => ((DateTime)d.Date).ToString("dd/MM")).ToList()
                                    ));

                        new Chart(ctx7, {
                            type: 'bar',
                            data: {
                                labels: dailyLabels,
                                datasets: [{
                                    label: 'Lượt tham quan',
                                    data: dailyData,
                                    backgroundColor: 'rgba(232,93,4,0.3)',
                                    borderColor: '#E85D04',
                                    borderWidth: 2,
                                    borderRadius: 6,
                                }]
                            },
                            options: {
                                responsive: true, maintainAspectRatio: false,
                                plugins: { legend: { display: false } },
                                scales: {
                                    x: { grid: { color: '#252840' }, ticks: { color: '#8B8FA8', font: { size: 11 } } },
                                    y: { grid: { color: '#252840' }, ticks: { color: '#8B8FA8', font: { size: 11 } }, beginAtZero: true }
                                }
                            }
                        });

                        // Lang donut chart
                        const ctxLang = document.getElementById('langChart').getContext('2d');
                        const langData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                                                                                                                                            (ViewBag.LangStats as IEnumerable<dynamic> ?? new List<dynamic>())
                                                                                                                                                                                                                                            .Select(s => (int)s.Count).ToList()
                                    ));
                        const langLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                                                                                                                                            (ViewBag.LangStats as IEnumerable<dynamic> ?? new List<dynamic>())
                                                                                                                                                                                                                                            .Select(s => (string)s.Language ?? "vi").ToList()
                                    ));

                        new Chart(ctxLang, {
                            type: 'doughnut',
                            data: {
                                labels: langLabels,
                                datasets: [{
                                    data: langData,
                                    backgroundColor: ['#E85D04', '#3B82F6', '#8B5CF6', '#22C55E'],
                                    borderWidth: 0,
                                }]
                            },
                            options: {
                                responsive: true, maintainAspectRatio: false,
                                plugins: { legend: { display: false } },
                                cutout: '70%'
                            }
                        });
                    </script>
                }
