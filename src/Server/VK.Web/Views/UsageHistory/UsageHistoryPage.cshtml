@{
    ViewData["Title"] = "Lịch sử sử dụng";
    Layout = "_AdminLayout";

    var logs = ViewBag.Logs as IEnumerable<VK.Core.Entities.VisitLog> ?? new List<VK.Core.Entities.VisitLog>();
    var topListened = ViewBag.TopListened as IEnumerable<VK.Web.Controllers.UsageHistoryController.TopListenedPoiVm>
        ?? new List<VK.Web.Controllers.UsageHistoryController.TopListenedPoiVm>();
    var avgListen = ViewBag.AvgListen as IEnumerable<VK.Web.Controllers.UsageHistoryController.AverageListenPoiVm>
        ?? new List<VK.Web.Controllers.UsageHistoryController.AverageListenPoiVm>();
    var heatmap = ViewBag.Heatmap as IEnumerable<VK.Web.Controllers.UsageHistoryController.HeatmapPointVm>
        ?? new List<VK.Web.Controllers.UsageHistoryController.HeatmapPointVm>();
    var anonymousRoutes = ViewBag.AnonymousRoutes as IEnumerable<VK.Web.Controllers.UsageHistoryController.AnonymousRouteVm>
        ?? new List<VK.Web.Controllers.UsageHistoryController.AnonymousRouteVm>();

    int total = ViewBag.Total ?? 0;
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 15;
    int audioPlayedCount = ViewBag.AudioPlayedCount ?? 0;
    int distinctLanguageCount = ViewBag.DistinctLanguageCount ?? 0;
    int distinctPoiCount = ViewBag.DistinctPoiCount ?? 0;

    string? selectedLanguage = ViewBag.Language as string;
    int? selectedPoiId = ViewBag.PoiId as int?;
    string? fromDateValue = ViewBag.FromDate as string;
    string? toDateValue = ViewBag.ToDate as string;

    string BuildPageUrl(int targetPage)
    {
        var query = new List<string> { $"page={targetPage}" };
        if (!string.IsNullOrWhiteSpace(selectedLanguage))
            query.Add($"language={Uri.EscapeDataString(selectedLanguage)}");
        if (selectedPoiId.HasValue)
            query.Add($"poiId={selectedPoiId.Value}");
        if (!string.IsNullOrWhiteSpace(fromDateValue))
            query.Add($"fromDate={Uri.EscapeDataString(fromDateValue)}");
        if (!string.IsNullOrWhiteSpace(toDateValue))
            query.Add($"toDate={Uri.EscapeDataString(toDateValue)}");
        return "/UsageHistory?" + string.Join("&", query);
    }

    var langMap = new Dictionary<string, (string flag, string css)>
    {
        ["vi"] = ("🇻🇳", "lang-vi"),
        ["en"] = ("🇺🇸", "lang-en"),
        ["ko"] = ("🇰🇷", "lang-ko"),
    };
}

<div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;">
    <div>
        <div class="page-title">Lịch sử sử dụng</div>
        <div class="page-subtitle">Theo dõi toàn bộ lượt tham quan và tương tác của du khách</div>
    </div>
</div>

<!-- STAT CARDS -->
<div class="stat-cards" style="grid-template-columns:repeat(4,1fr);">
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-icon orange"><i class="fa-solid fa-person-walking"></i></div>
        </div>
        <div class="stat-value">@total</div>
        <div class="stat-label">Tổng lượt tham quan</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-icon blue"><i class="fa-solid fa-headphones"></i></div>
        </div>
        <div class="stat-value">@audioPlayedCount</div>
        <div class="stat-label">Lượt phát audio</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-icon green"><i class="fa-solid fa-globe"></i></div>
        </div>
        <div class="stat-value">@distinctLanguageCount</div>
        <div class="stat-label">Ngôn ngữ sử dụng</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-icon purple"><i class="fa-solid fa-map-pin"></i></div>
        </div>
        <div class="stat-value">@distinctPoiCount</div>
        <div class="stat-label">Địa điểm được ghé thăm</div>
    </div>
</div>

<!-- ANALYTICS (REST API) -->
<div class="grid-2-1" style="margin-bottom:24px;grid-template-columns:repeat(2,1fr);">
    <div class="admin-card">
        <div class="admin-card-header">
            <div class="admin-card-title">Top địa điểm được nghe nhiều nhất</div>
        </div>
        <div class="admin-card-body" style="padding-top:0;">
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>POI</th>
                            <th>Lượt nghe</th>
                            <th>Khách nghe</th>
                            <th>Hoàn tất</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (topListened.Any())
                        {
                            @foreach (var item in topListened)
                            {
                                <tr>
                                    <td>@item.POIName</td>
                                    <td>@item.AudioPlayCount</td>
                                    <td>@item.UniqueListeners</td>
                                    <td>@item.AudioCompleteCount</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align:center;color:var(--text-muted);">Chưa có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="admin-card">
        <div class="admin-card-header">
            <div class="admin-card-title">Thời gian trung bình nghe 1 POI</div>
        </div>
        <div class="admin-card-body" style="padding-top:0;">
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>POI</th>
                            <th>Trung bình</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (avgListen.Any())
                        {
                            @foreach (var item in avgListen)
                            {
                                <tr>
                                    <td>@item.POIName</td>
                                    <td>@TimeSpan.FromSeconds(item.AverageDurationSeconds).ToString("mm\\:ss")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" style="text-align:center;color:var(--text-muted);">Chưa có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Heatmap vị trí người dùng -->
<div class="admin-card" style="margin-bottom:24px;">
    <div class="admin-card-header">
        <div>
            <div class="admin-card-title">Heatmap vị trí người dùng</div>
            <div class="admin-card-subtitle">Bản đồ nhiệt hiển thị mật độ tập trung người dùng</div>
        </div>
    </div>
    <div class="admin-card-body" style="padding:0;">
        @if (heatmap.Any())
        {
            <div id="heatmapContainer" style="height:400px;width:100%;"></div>
        }
        else
        {
            <div style="padding:60px;text-align:center;color:#9CA3AF;">
                <i class="fa-solid fa-map-location-dot" style="font-size:48px;opacity:0.3;"></i>
                <p style="margin-top:12px;">Chưa có dữ liệu vị trí</p>
            </div>
        }
    </div>
</div>

<!-- Lưu tuyến di chuyển (ẩn danh) -->
<div class="admin-card" style="margin-bottom:24px;">
    <div class="admin-card-header">
        <div style="flex:1;">
            <div class="admin-card-title">Lưu tuyến di chuyển (ẩn danh)</div>
            <div class="admin-card-subtitle">Hiển thị hành trình di chuyển của du khách</div>
        </div>
        @if (anonymousRoutes.Any())
        {
            <div style="display:flex;gap:8px;align-items:center;">
                <label style="font-size:13px;color:#6B7280;">Chọn tuyến:</label>
                <select id="routeSelector" style="padding:6px 12px;border-radius:6px;border:1px solid #E5E7EB;background:white;font-size:13px;">
                    @for (int i = 0; i < anonymousRoutes.Take(10).Count(); i++)
                    {
                        var route = anonymousRoutes.Skip(i).First();
                        <option value="@i">Route #@(i + 1) - @route.AnonymousVisitorId (@route.PointCount POI)</option>
                    }
                </select>
            </div>
        }
    </div>
    <div class="admin-card-body" style="padding:0;">
        @if (anonymousRoutes.Any())
        {
            <div id="routesMapContainer" style="height:400px;width:100%;"></div>
        }
        else
        {
            <div style="padding:60px;text-align:center;color:#9CA3AF;">
                <i class="fa-solid fa-route" style="font-size:48px;opacity:0.3;"></i>
                <p style="margin-top:12px;">Chưa có dữ liệu lưu tuyến</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>

    <script>
        const heatmapData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            heatmap.Select(h => new { lat = h.Latitude, lng = h.Longitude, weight = h.Weight }).ToList()
        ));

        if (heatmapData.length > 0) {
            const avgLat = heatmapData.reduce((sum, p) => sum + p.lat, 0) / heatmapData.length;
            const avgLng = heatmapData.reduce((sum, p) => sum + p.lng, 0) / heatmapData.length;

            const map = L.map('heatmapContainer').setView([avgLat, avgLng], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(map);

            const heatData = heatmapData.map(d => [d.lat, d.lng, d.weight]);
            L.heatLayer(heatData, {
                radius: 25,
                blur: 15,
                maxZoom: 17,
                max: 1.0,
                gradient: {
                    0.0: 'rgba(59, 130, 246, 0.1)',
                    0.3: 'rgba(139, 92, 246, 0.5)',
                    0.5: 'rgba(232, 93, 4, 0.7)',
                    0.7: 'rgba(239, 68, 68, 0.8)',
                    1.0: 'rgba(220, 38, 38, 1)'
                }
            }).addTo(map);
        }

        const routesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            anonymousRoutes.Take(10).Select(r => new {
                id = r.AnonymousVisitorId,
                pointCount = r.PointCount,
                firstSeen = r.FirstSeenAt.ToLocalTime().ToString("dd/MM HH:mm"),
                lastSeen = r.LastSeenAt.ToLocalTime().ToString("HH:mm"),
                points = r.Points.Select(p => new { lat = p.Latitude, lng = p.Longitude }).ToList()
            }).ToList()
        ));

        if (routesData.length > 0) {
            const firstRoute = routesData[0];
            const avgRouteLat = firstRoute.points.reduce((sum, p) => sum + p.lat, 0) / firstRoute.points.length;
            const avgRouteLng = firstRoute.points.reduce((sum, p) => sum + p.lng, 0) / firstRoute.points.length;

            const routesMap = L.map('routesMapContainer').setView([avgRouteLat, avgRouteLng], 14);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(routesMap);

            let currentPolyline = null;
            let currentMarkers = [];

            function displayRoute(routeIndex) {
                if (currentPolyline) {
                    routesMap.removeLayer(currentPolyline);
                }
                currentMarkers.forEach(m => routesMap.removeLayer(m));
                currentMarkers = [];

                const route = routesData[routeIndex];
                const coords = route.points.map(p => [p.lat, p.lng]);

                currentPolyline = L.polyline(coords, {
                    color: '#E85D04',
                    weight: 4,
                    opacity: 0.8,
                    smoothFactor: 1
                }).addTo(routesMap);

                route.points.forEach((point, idx) => {
                    const isStart = idx === 0;
                    const isEnd = idx === route.points.length - 1;

                    const marker = L.circleMarker([point.lat, point.lng], {
                        radius: isStart || isEnd ? 8 : 6,
                        fillColor: isStart ? '#22C55E' : (isEnd ? '#DC2626' : '#3B82F6'),
                        color: '#fff',
                        weight: 2,
                        opacity: 1,
                        fillOpacity: 0.9
                    }).addTo(routesMap);

                    marker.bindPopup(`
                        <div style="font-size:12px;">
                            <strong>${isStart ? '🟢 Điểm bắt đầu' : (isEnd ? '🔴 Điểm kết thúc' : '📍 Điểm ' + (idx + 1))}</strong><br>
                            Visitor: ${route.id}<br>
                            Thời gian: ${route.firstSeen} - ${route.lastSeen}
                        </div>
                    `);

                    currentMarkers.push(marker);
                });

                routesMap.fitBounds(currentPolyline.getBounds(), { padding: [30, 30] });
            }

            displayRoute(0);

            const routeSelector = document.getElementById('routeSelector');
            if (routeSelector) {
                routeSelector.addEventListener('change', function (e) {
                    displayRoute(parseInt(e.target.value));
                });
            }
        }
    </script>
}
