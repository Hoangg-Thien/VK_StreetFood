@{
    ViewData["Title"] = "Quản lý Tour";
    Layout = "_AdminLayout";

    var tours = ViewBag.Tours as IEnumerable<VK.Core.Entities.Tour> ?? new List<VK.Core.Entities.Tour>();
    var pois = ViewBag.POIs as IEnumerable<VK.Core.Entities.PointOfInterest> ?? new List<VK.Core.Entities.PointOfInterest>();
    var categories = ViewBag.Categories as IEnumerable<VK.Core.Entities.Category> ?? new List<VK.Core.Entities.Category>();
    int totalTours = ViewBag.TotalTours ?? tours.Count();
    int totalPOIs = ViewBag.TotalPOIs ?? 0;
    int totalAudio = ViewBag.TotalAudio ?? 0;
    var statusFilter = (ViewBag.Status as string ?? string.Empty).ToLowerInvariant();
}

@if (TempData["Success"] != null)
{
    <div style="background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.2);border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#22C55E;font-size:13px;">
        <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#EF4444;font-size:13px;">
        <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
    </div>
}

<div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;">
    <div>
        <div class="page-title">Quản lý Tour</div>
        <div class="page-subtitle">Tạo và quản lý các tuyến tham quan ẩm thực đường phố</div>
    </div>
    <button class="btn-primary-admin" onclick="openModal('addTourModal')">
        <i class="fa-solid fa-plus"></i>
        Tạo tour mới
    </button>
</div>

<!-- STAT CARDS -->
<div class="stat-cards" style="margin-bottom:24px;">
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-icon orange"><i class="fa-solid fa-route"></i></div>
        </div>
        <div class="stat-value">@totalTours</div>
        <div class="stat-label">Tổng số tour</div>
        <div class="stat-compare">@tours.Count(t => t.Status == "active") đang hoạt động</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-icon green"><i class="fa-solid fa-map-pin"></i></div>
        </div>
        <div class="stat-value">@totalPOIs</div>
        <div class="stat-label">Địa điểm sẵn có</div>
        <div class="stat-compare">Để gán vào tour</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-icon blue"><i class="fa-solid fa-headphones"></i></div>
        </div>
        <div class="stat-value">@totalAudio</div>
        <div class="stat-label">Nội dung audio</div>
        <div class="stat-compare">Đã được thuyết minh</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-icon purple"><i class="fa-solid fa-globe"></i></div>
        </div>
        <div class="stat-value">3</div>
        <div class="stat-label">Ngôn ngữ hỗ trợ</div>
        <div class="stat-compare">VI · EN · KO</div>
    </div>
</div>

<!-- TOUR CARDS GRID -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
    <div style="font-size:14px;font-weight:600;color:var(--text-secondary);">
        Tất cả tour (@totalTours)
    </div>
    <form method="get" action="/Tour" style="display:flex;gap:8px;">
        <select name="status" class="form-control-admin" style="width:auto;padding:8px 12px;font-size:13px;">
            <option value="" selected="@(string.IsNullOrEmpty(statusFilter) ? "selected" : null)">Tất cả trạng thái</option>
            <option value="active" selected="@(statusFilter == "active" ? "selected" : null)">Đang hoạt động</option>
            <option value="draft" selected="@(statusFilter == "draft" ? "selected" : null)">Nháp</option>
            <option value="inactive" selected="@(statusFilter == "inactive" ? "selected" : null)">Tạm dừng</option>
        </select>
        <button type="submit" class="btn-secondary-admin" style="font-size:12px;padding:8px 12px;">Lọc</button>
    </form>
</div>

<div class="grid-cards">
    @if (tours.Any())
    {
        @foreach (var tour in tours)
        {
            var statusCss = tour.Status == "active" ? "badge-active" : tour.Status == "draft" ? "badge-pending" : "badge-inactive";
            var statusLabel = tour.Status == "active" ? "Hoạt động" : tour.Status == "draft" ? "Nháp" : "Tạm dừng";
            var poiCount = tour.TourPoints.Count;
            var durationLabel = tour.EstimatedDurationMinutes.HasValue
                ? (tour.EstimatedDurationMinutes.Value < 60
                    ? $"{tour.EstimatedDurationMinutes.Value} phút"
                    : (tour.EstimatedDurationMinutes.Value % 60 == 0
                        ? $"{tour.EstimatedDurationMinutes.Value / 60} giờ"
                        : $"{tour.EstimatedDurationMinutes.Value / 60d:0.#} giờ"))
                : "—";

            <div class="tour-card">
                <div class="tour-card-img" style="background:linear-gradient(135deg,#1A1D2E,#252840);">
                    <span style="font-size:52px;">@tour.Emoji</span>
                    <span class="badge-status @statusCss" style="position:absolute;top:12px;right:12px;">@statusLabel</span>
                </div>
                <div class="tour-card-body">
                    <div class="tour-card-title">@tour.Name</div>
                    <div style="font-size:12px;color:var(--text-muted);margin-bottom:10px;line-height:1.6;">@tour.Description</div>
                    <div class="tour-card-meta">
                        <span><i class="fa-solid fa-map-pin"></i> @poiCount địa điểm</span>
                        <span><i class="fa-regular fa-clock"></i> @durationLabel</span>
                        <span><i class="fa-solid fa-globe"></i> 3 ngôn ngữ</span>
                    </div>
                </div>
                <div class="tour-card-footer">
                    <div style="display:flex;gap:6px;">
                        <button class="action-btn edit"
                                onclick='openEditTourModal(@tour.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tour.Name)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tour.Description ?? "")), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tour.Emoji)), @(tour.EstimatedDurationMinutes.HasValue ? tour.EstimatedDurationMinutes.Value.ToString() : "null"), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tour.Status)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tour.TourPoints.OrderBy(tp => tp.SortOrder).Select(tp => tp.PointOfInterestId).ToList())))'
                                title="Chỉnh sửa">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="action-btn view" title="Xem chi tiết" onclick="alert('Tính năng chi tiết tour đang được phát triển.');">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                        <form method="post" action="/Tour/Delete" style="display:inline;" onsubmit="return confirm('Xóa tour này?')">
                            <input type="hidden" name="id" value="@tour.Id" />
                            <button type="submit" class="action-btn delete" title="Xóa">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </div>
                    <a href="javascript:void(0)" class="btn-primary-admin" style="font-size:11px;padding:6px 12px;">
                        <i class="fa-solid fa-route"></i> Xem lộ trình
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="admin-card" style="grid-column:1/-1;">
            <div class="empty-state">
                <i class="fa-solid fa-route"></i>
                <p>Chưa có tour nào. Hãy tạo tour đầu tiên!</p>
            </div>
        </div>
    }
</div>

<!-- POI LIST FOR TOUR BUILDING -->
@if (pois.Any())
{
    <div style="margin-top:32px;">
        <div class="admin-card-title" style="margin-bottom:16px;font-size:16px;">
            <i class="fa-solid fa-list-check" style="color:var(--accent-orange);margin-right:8px;"></i>
            Địa điểm sẵn sàng gán vào tour
        </div>
        <div class="admin-card">
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Địa điểm</th>
                            <th>Danh mục</th>
                            <th>Audio</th>
                            <th>Đánh giá</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var poi in pois.Take(8))
                        {
                            var bg = new[] { "#E85D04","#3B82F6","#8B5CF6","#22C55E","#F59E0B" };
                            var init = string.Join("", poi.Name.Split(' ').Where(w=>w.Length>0).Take(2).Select(w=>w[0].ToString().ToUpper()));
                            <tr>
                                <td>
                                    <div class="item-info">
                                        <div class="table-avatar" style="background:@bg[Math.Abs(poi.Id.GetHashCode())%bg.Length];">@init</div>
                                        <div>
                                            <div class="item-name">@poi.Name</div>
                                            <div class="item-sub">@poi.Address</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@(poi.Category?.Name ?? "—")</td>
                                <td>
                                    <span style="color:var(--accent-orange);font-size:12px;">
                                        <i class="fa-solid fa-headphones"></i> @poi.AudioContents.Count
                                    </span>
                                </td>
                                <td>
                                    <span style="color:var(--yellow);font-size:12px;">
                                        <i class="fa-solid fa-star"></i> @poi.AverageRating.ToString("F1")
                                    </span>
                                </td>
                                <td>
                                    @if (poi.IsActive) { <span class="badge-status badge-active">Hoạt động</span> }
                                    else { <span class="badge-status badge-inactive">Tạm dừng</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (pois.Count() > 8)
            {
                <div class="pagination-wrap">
                    <span>Hiển thị 8 trong @totalPOIs địa điểm</span>
                    <a href="/Poi" class="btn-secondary-admin" style="font-size:12px;padding:6px 12px;">Xem tất cả</a>
                </div>
            }
        </div>
    </div>
}

<!-- ADD TOUR MODAL -->
<div class="modal-overlay" id="addTourModal">
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-title"><i class="fa-solid fa-route" style="color:var(--accent-orange);margin-right:8px;"></i>Tạo tour mới</span>
            <button class="modal-close" onclick="closeModal('addTourModal')"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="/Tour/Create">
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Tên tour *</label>
                    <input type="text" name="Name" class="form-control-admin" placeholder="VD: Tour ẩm thực buổi sáng..." required />
                </div>
                <div class="form-group">
                    <label class="form-label">Mô tả</label>
                    <textarea name="Description" class="form-control-admin" rows="3" placeholder="Mô tả ngắn về tour..."></textarea>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="form-group">
                        <label class="form-label">Thời lượng ước tính (phút)</label>
                        <input type="number" name="EstimatedDurationMinutes" min="1" class="form-control-admin" placeholder="VD: 120" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Icon (emoji)</label>
                        <input type="text" name="Emoji" class="form-control-admin" placeholder="🍜" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Trạng thái</label>
                    <select name="Status" class="form-control-admin">
                        <option value="draft" selected>Nháp</option>
                        <option value="active">Hoạt động</option>
                        <option value="inactive">Tạm dừng</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Chọn địa điểm</label>
                    <div style="max-height:180px;overflow-y:auto;border:1px solid var(--border-color);border-radius:8px;">
                        @foreach (var poi in pois.Take(15))
                        {
                            <label style="display:flex;align-items:center;gap:8px;padding:8px 12px;cursor:pointer;border-bottom:1px solid var(--border-color);">
                                <input type="checkbox" name="PoiIds" value="@poi.Id" style="accent-color:var(--accent-orange);" />
                                <span style="font-size:13px;">@poi.Name</span>
                                <span style="font-size:11px;color:var(--text-muted);margin-left:auto;">@(poi.Category?.Name ?? "—")</span>
                            </label>
                        }
                        @if (!pois.Any())
                        {
                            <div style="padding:16px;text-align:center;color:var(--text-muted);font-size:13px;">
                                Chưa có địa điểm nào. <a href="/Poi" style="color:var(--accent-orange);">Thêm ngay</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" onclick="closeModal('addTourModal')">Hủy</button>
                <button type="submit" class="btn-primary-admin">
                    <i class="fa-solid fa-floppy-disk"></i> Lưu tour
                </button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT TOUR MODAL -->
<div class="modal-overlay" id="editTourModal">
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-title"><i class="fa-solid fa-pen" style="color:var(--blue);margin-right:8px;"></i>Chỉnh sửa tour</span>
            <button class="modal-close" onclick="closeModal('editTourModal')"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="/Tour/Edit">
            <div class="modal-body">
                <input type="hidden" id="editTourId" name="Id" />
                <div class="form-group">
                    <label class="form-label">Tên tour</label>
                    <input type="text" id="editTourName" name="Name" class="form-control-admin" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Mô tả</label>
                    <textarea id="editTourDesc" name="Description" class="form-control-admin" rows="3"></textarea>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="form-group">
                        <label class="form-label">Thời lượng ước tính (phút)</label>
                        <input type="number" id="editTourDuration" name="EstimatedDurationMinutes" min="1" class="form-control-admin" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Icon (emoji)</label>
                        <input type="text" id="editTourEmoji" name="Emoji" class="form-control-admin" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Trạng thái</label>
                    <select id="editTourStatus" name="Status" class="form-control-admin">
                        <option value="active">Hoạt động</option>
                        <option value="inactive">Tạm dừng</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Chọn địa điểm</label>
                    <div style="max-height:180px;overflow-y:auto;border:1px solid var(--border-color);border-radius:8px;">
                        @foreach (var poi in pois.Take(15))
                        {
                            <label style="display:flex;align-items:center;gap:8px;padding:8px 12px;cursor:pointer;border-bottom:1px solid var(--border-color);">
                                <input type="checkbox" name="PoiIds" value="@poi.Id" class="edit-tour-poi" style="accent-color:var(--accent-orange);" />
                                <span style="font-size:13px;">@poi.Name</span>
                                <span style="font-size:11px;color:var(--text-muted);margin-left:auto;">@(poi.Category?.Name ?? "—")</span>
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" onclick="closeModal('editTourModal')">Hủy</button>
                <button type="submit" class="btn-primary-admin">
                    <i class="fa-solid fa-floppy-disk"></i> Cập nhật
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function openEditTourModal(id, name, desc, emoji, durationMinutes, status, poiIds) {
    document.getElementById('editTourId').value = id;
    document.getElementById('editTourName').value = name;
    document.getElementById('editTourDesc').value = desc;
    document.getElementById('editTourEmoji').value = emoji || '🍜';
    document.getElementById('editTourDuration').value = durationMinutes ?? '';
    document.getElementById('editTourStatus').value = status || 'draft';

    const selectedPoiIds = Array.isArray(poiIds) ? poiIds.map(Number) : [];
    document.querySelectorAll('.edit-tour-poi').forEach((checkbox) => {
        checkbox.checked = selectedPoiIds.includes(Number(checkbox.value));
    });

    openModal('editTourModal');
}
</script>
}
