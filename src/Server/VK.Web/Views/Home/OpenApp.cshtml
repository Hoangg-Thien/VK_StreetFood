@{
    Layout = null;
    var appDeepLink = ViewBag.AppDeepLink as string ?? "vkstreetfood://pay";
    var androidStoreUrl = ViewBag.AndroidStoreUrl as string ?? "https://play.google.com/store/apps/details?id=com.vkstreetfood.mobile";
    var iosStoreUrl = ViewBag.IosStoreUrl as string ?? "https://apps.apple.com/app/id0000000000";
    var webFallbackUrl = ViewBag.WebFallbackUrl as string ?? "/";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mở VK StreetFood</title>
    <style>
        body {
            margin: 0;
            font-family: Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif;
            background: linear-gradient(140deg, #fff7ed, #ffedd5);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1f2937;
        }
        .card {
            width: min(92vw, 420px);
            background: #ffffff;
            border: 1px solid #fed7aa;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(194, 77, 2, 0.18);
            padding: 22px;
        }
        h1 { margin: 0 0 8px; font-size: 22px; }
        p { margin: 0 0 14px; color: #6b7280; }
        .actions { display: flex; gap: 10px; flex-wrap: wrap; }
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            border-radius: 10px;
            padding: 10px 14px;
            font-weight: 600;
            font-size: 14px;
            border: 1px solid #d1d5db;
            color: #374151;
            background: #fff;
        }
        .btn.primary {
            background: #ea580c;
            border-color: #ea580c;
            color: #fff;
        }
        .hint { margin-top: 12px; font-size: 12px; color: #9ca3af; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Mở thanh toán VK StreetFood</h1>
        <p>Nếu chưa cài ứng dụng, hãy tải app trước. Cài xong bấm "Đã cài xong - Mở thanh toán".</p>
        <div class="actions">
            <a class="btn primary" id="openAppBtn" href="@appDeepLink">Mở app ngay</a>
            <a class="btn" id="installBtn" href="@androidStoreUrl">Tải ứng dụng</a>
            <a class="btn" id="openAfterInstallBtn" href="@appDeepLink">Đã cài xong - Mở thanh toán</a>
        </div>
        <div class="hint" id="platformHint">Android: cần cho phép cài đặt từ nguồn không xác định nếu cài APK trực tiếp.</div>
    </div>

    <script>
        (function () {
            const appDeepLink = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(appDeepLink));
            const androidStoreUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(androidStoreUrl));
            const iosStoreUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(iosStoreUrl));
            const webFallbackUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(webFallbackUrl));

            const ua = navigator.userAgent || "";
            const isAndroid = /Android/i.test(ua);
            const isIos = /iPhone|iPad|iPod/i.test(ua);
            const installUrl = isAndroid ? androidStoreUrl : (isIos ? iosStoreUrl : webFallbackUrl);

            const installBtn = document.getElementById("installBtn");
            const platformHint = document.getElementById("platformHint");
            if (installBtn) {
                installBtn.href = installUrl;
            }

            if (platformHint && isIos) {
                platformHint.textContent = "iOS: hãy cài qua TestFlight/IPA enterprise, sau đó bấm Mở thanh toán.";
            }

            if (platformHint && !isAndroid && !isIos) {
                platformHint.textContent = "Thiết bị này không phải mobile. Hãy mở link này trên điện thoại để cài app.";
            }

            window.location.href = appDeepLink;
            setTimeout(function () {
                window.location.href = installUrl;
            }, 1700);
        })();
    </script>
</body>
</html>
