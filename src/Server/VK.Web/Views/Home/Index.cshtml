@{
    ViewData["Title"] = "Đăng nhập Admin";
    Layout = null; // Standalone page - no layout
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - VK StreetFood Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: #f5f7fb;
            color: #111827;
        }

        .page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 48% 52%;
        }

        .hero {
            position: relative;
            background-image: url('/images/adBg/background.jpg');
            background-size: cover;
            background-position: center;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(9, 13, 23, 0.56);
        }

        .hero-content {
            position: absolute;
            left: 36px;
            bottom: 52px;
            z-index: 1;
            color: #ffffff;
            max-width: 420px;
        }

        .hero-logo {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.18);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 18px;
        }

        .hero-title {
            font-size: 34px;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 10px;
            text-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
        }

        .hero-desc {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.84);
            line-height: 1.6;
        }

        .auth-pane {
            background: #f4f6fb;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .login-card {
            width: 420px;
            background: #fff;
            border: 1px solid #e8ebf4;
            border-radius: 12px;
            padding: 34px 30px 24px;
            box-shadow: 0 16px 40px rgba(17, 24, 39, 0.10);
        }

        .card-title {
            text-align: center;
            font-size: 30px;
            font-weight: 700;
            color: #1a1d2e;
            margin-bottom: 8px;
        }

        .card-subtitle {
            text-align: center;
            font-size: 14px;
            color: #8b8fa8;
            margin-bottom: 24px;
        }

        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 6px;
            padding: 10px;
            display: flex;
            gap: 8px;
            font-size: 12px;
            color: #dc2626;
            margin-bottom: 14px;
            align-items: center;
        }

        .form-group { margin-bottom: 16px; }

        .form-label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #4b5065;
            margin-bottom: 8px;
        }

        .form-input {
            width: 100%;
            border: 1px solid #e8ebf4;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 14px;
            color: #111827;
            background: #f4f6fb;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

        .form-input:focus {
            border-color: #e85d04;
            box-shadow: 0 0 0 3px rgba(232, 93, 4, 0.12);
            background: #fff;
        }

        .input-wrap { position: relative; }

        .toggle-pass {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #b0b5c8;
            cursor: pointer;
            font-size: 14px;
        }

        .toggle-pass:hover { color: #8b8fa8; }

        .forgot-row {
            display: flex;
            justify-content: flex-end;
            margin: 6px 0 14px;
        }

        .forgot-link {
            font-size: 11px;
            color: #6366f1;
            text-decoration: none;
        }

        .forgot-link:hover { text-decoration: underline; }

        .btn-login {
            width: 100%;
            border: none;
            border-radius: 10px;
            padding: 13px;
            background: #e85d04;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s;
        }

        .btn-login:hover {
            background: #ff6b2b;
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(232, 93, 4, 0.32);
        }

        .card-footer {
            margin-top: 12px;
            text-align: center;
            font-size: 10px;
            color: #9ca3af;
        }

        .owner-link {
            display: block;
            margin-top: 10px;
            text-align: center;
            font-size: 12px;
            color: #e85d04;
            text-decoration: none;
            font-weight: 600;
        }

        .owner-link:hover { text-decoration: underline; }

        @@media (max-width: 1024px) {
            .page { grid-template-columns: 42% 58%; }
            .hero-content { left: 24px; bottom: 30px; }
            .hero-title { font-size: 28px; }
        }

        @@media (max-width: 768px) {
            .page { grid-template-columns: 1fr; }
            .hero { min-height: 220px; }
            .hero-content { left: 20px; bottom: 20px; }
            .hero-title { font-size: 24px; }
            .auth-pane { padding: 22px; }
            .login-card { width: 100%; max-width: 420px; padding: 28px 22px 22px; }
            .card-title { font-size: 26px; }
        }
    </style>
</head>
<body>
    <div class="page">
        <section class="hero" aria-hidden="true">
            <div class="hero-content">
                <div class="hero-logo"><i class="fa-solid fa-location-dot"></i></div>
                <h1 class="hero-title">Hệ thống quản lý<br />Ẩm thực đường phố</h1>
                <p class="hero-desc">Trung tâm điều phối toàn bộ hoạt động tại khu ẩm thực Vĩnh Khánh — quản lý địa điểm, audio thuyết minh, bản dịch đa ngôn ngữ và tour tham quan.</p>
            </div>
        </section>

        <section class="auth-pane">
            <div class="login-card">
                <h2 class="card-title">Chào mừng trở lại!</h2>
                <p class="card-subtitle">Đăng nhập để truy cập trang quản trị</p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert-error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        @ViewBag.Error
                    </div>
                }

                <form method="post" action="/Home/Login">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-input" placeholder="Nhập địa chỉ email..." autocomplete="email" required />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Mật khẩu</label>
                        <div class="input-wrap">
                            <input type="password" name="password" id="passwordInput" class="form-input" placeholder="Nhập mật khẩu..." autocomplete="current-password" required />
                            <button type="button" class="toggle-pass" onclick="togglePassword()">
                                <i class="fa-solid fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-login">Đăng nhập</button>
                </form>

                <div style="margin-top:12px; text-align:center; font-size:12px; color:#6b7280;">
                    Bạn là chủ quán? <a href="/Home/OwnerRegister" class="owner-link" style="display:inline; margin-top:0;">Đăng ký tài khoản</a>
                </div>
            </div>
        </section>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa-solid fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa-solid fa-eye';
            }
        }
    </script>
</body>
</html>