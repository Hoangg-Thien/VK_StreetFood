@{
    ViewData["Title"] = "Đăng nhập Admin";
    Layout = null; // Standalone page - no layout
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - VK StreetFood Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

            body {
                font-family: 'Inter', sans-serif;
                background: #F4F6FB;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
            }

            /* Subtle dot grid background */
            .bg-dec {
                position: fixed;
                inset: 0;
                pointer-events: none;
                z-index: 0;
                background-image: radial-gradient(circle, #D4D8EA 1px, transparent 1px);
                background-size: 28px 28px;
                opacity: 0.6;
            }

            /* Soft orange blobs */
            .bg-blob {
                position: fixed;
                border-radius: 50%;
                filter: blur(100px);
                opacity: 0.18;
                pointer-events: none;
                z-index: 0;
            }
            .bg-blob-1 { width: 500px; height: 500px; background: #E85D04; top: -160px; left: -160px; }
            .bg-blob-2 { width: 350px; height: 350px; background: #FBBF24; bottom: -100px; right: -80px; }

            /* Login container */
            .login-wrap {
                position: relative;
                z-index: 10;
                display: flex;
                width: 920px;
                max-width: 97vw;
                min-height: 540px;
                border-radius: 20px;
                overflow: hidden;
                box-shadow: 0 8px 40px rgba(0,0,0,0.1);
                border: 1px solid #E8EBF4;
            }

            /* LEFT PANEL */
            .login-left {
                flex: 1;
                background: linear-gradient(145deg, #E85D04 0%, #C24D02 100%);
                padding: 48px 44px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                position: relative;
                overflow: hidden;
            }

            .login-left::before {
                content: '';
                position: absolute;
                width: 300px; height: 300px;
                background: rgba(255,255,255,0.07);
                border-radius: 50%;
                top: -80px; right: -80px;
            }

            .login-left::after {
                content: '';
                position: absolute;
                width: 200px; height: 200px;
                background: rgba(255,255,255,0.05);
                border-radius: 50%;
                bottom: -60px; left: -40px;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                position: relative; z-index: 1;
            }

            .brand-icon {
                width: 44px; height: 44px;
                background: rgba(255,255,255,0.2);
                border-radius: 12px;
                display: flex; align-items: center; justify-content: center;
                font-size: 22px;
            }

            .brand-name { font-size: 18px; font-weight: 700; color: #fff; }
            .brand-sub {
                font-size: 10px;
                color: rgba(255,255,255,0.75);
                text-transform: uppercase;
                letter-spacing: 1px;
                font-weight: 600;
            }

            .panel-title {
                font-size: 30px;
                font-weight: 700;
                color: #fff;
                line-height: 1.3;
                margin-bottom: 14px;
                position: relative; z-index: 1;
            }

            .panel-desc {
                font-size: 14px;
                color: rgba(255,255,255,0.8);
                line-height: 1.7;
                margin-bottom: 32px;
                position: relative; z-index: 1;
            }

            .panel-stats {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                position: relative; z-index: 1;
            }

            .panel-stat {
                background: rgba(255,255,255,0.12);
                border: 1px solid rgba(255,255,255,0.18);
                border-radius: 12px;
                padding: 14px 16px;
                backdrop-filter: blur(4px);
            }

            .panel-stat-val { font-size: 22px; font-weight: 700; color: #fff; }
            .panel-stat-label { font-size: 11px; color: rgba(255,255,255,0.7); margin-top: 3px; }

            .panel-footer { font-size: 12px; color: rgba(255,255,255,0.5); position: relative; z-index: 1; }

            /* RIGHT PANEL */
            .login-right {
                width: 420px;
                background: #FFFFFF;
                padding: 52px 44px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .login-header { margin-bottom: 32px; }

            .login-title { font-size: 22px; font-weight: 700; color: #1A1D2E; margin-bottom: 6px; }
            .login-subtitle { font-size: 13px; color: #8B8FA8; }

            /* Error alert */
            .alert-error {
                background: #FEF2F2;
                border: 1px solid #FECACA;
                border-radius: 8px;
                padding: 12px 14px;
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
                color: #DC2626;
                margin-bottom: 20px;
            }

            .form-group { margin-bottom: 18px; }

            .form-label {
                display: block;
                font-size: 12px;
                font-weight: 600;
                color: #4B5065;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                margin-bottom: 8px;
            }

            .input-wrap { position: relative; }

            .input-icon {
                position: absolute;
                left: 14px; top: 50%;
                transform: translateY(-50%);
                color: #B0B5C8;
                font-size: 14px;
                pointer-events: none;
            }

            .form-input {
                width: 100%;
                background: #F4F6FB;
                border: 1px solid #E8EBF4;
                border-radius: 10px;
                padding: 12px 14px 12px 42px;
                color: #1A1D2E;
                font-size: 14px;
                font-family: 'Inter', sans-serif;
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

            .form-input:focus {
                border-color: #E85D04;
                box-shadow: 0 0 0 3px rgba(232,93,4,0.1);
                background: #fff;
            }

            .form-input::placeholder { color: #C0C4D4; }

            .toggle-pass {
                position: absolute;
                right: 14px; top: 50%;
                transform: translateY(-50%);
                background: none; border: none;
                color: #B0B5C8;
                cursor: pointer; font-size: 14px; padding: 0;
            }
            .toggle-pass:hover { color: #8B8FA8; }

            .form-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 24px;
                font-size: 13px;
            }

            .remember-wrap {
                display: flex; align-items: center; gap: 7px;
                color: #8B8FA8; cursor: pointer;
            }
            .remember-wrap input[type="checkbox"] { width: 15px; height: 15px; accent-color: #E85D04; }

            .forgot-link { color: #E85D04; text-decoration: none; font-size: 12px; }
            .forgot-link:hover { text-decoration: underline; }

            .btn-login {
                width: 100%;
                padding: 13px;
                background: #E85D04;
                color: #fff;
                border: none; border-radius: 10px;
                font-size: 14px; font-weight: 700;
                font-family: 'Inter', sans-serif;
                cursor: pointer;
                transition: all 0.2s;
                display: flex; align-items: center; justify-content: center; gap: 8px;
            }

            .btn-login:hover {
                background: #FF6B2B;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(232,93,4,0.35);
            }

            .btn-login:active { transform: translateY(0); }

            .demo-hint {
                margin-top: 20px;
                background: #FFF7F4;
                border: 1px solid #FFD4BC;
                border-radius: 8px;
                padding: 12px 14px;
                font-size: 12px;
                color: #6B5040;
                line-height: 1.7;
            }

            .demo-hint strong { color: #E85D04; }

            @@media (max-width: 768px) {
                .login-left { display: none; }
                .login-right { width: 100%; padding: 36px 28px; }
                .login-wrap { min-height: auto; }
            }
    </style>
</head>
<body>
    <div class="bg-dec"></div>
    <div class="bg-blob bg-blob-1"></div>
    <div class="bg-blob bg-blob-2"></div>

    <div class="login-wrap">
        <!-- LEFT PANEL -->
        <div class="login-left">
            <div class="brand">
                <div class="brand-icon">🍜</div>
                <div>
                    <div class="brand-name">Vĩnh Khánh</div>
                    <div class="brand-sub">Street Food Admin</div>
                </div>
            </div>

            <div>
                <h1 class="panel-title">
                    Hệ thống quản lý<br />Ẩm thực đường phố
                </h1>
                <p class="panel-desc">
                    Trung tâm điều phối toàn bộ hoạt động tại khu ẩm thực Vinh Khánh —
                    quản lý địa điểm, audio thuyết minh, bản dịch đa ngôn ngữ và tour tham quan.
                </p>

                <div class="panel-stats">
                    <div class="panel-stat">
                        <div class="panel-stat-val">3</div>
                        <div class="panel-stat-label">Ngôn ngữ hỗ trợ</div>
                    </div>
                    <div class="panel-stat">
                        <div class="panel-stat-val">24/7</div>
                        <div class="panel-stat-label">Sẵn sàng hoạt động</div>
                    </div>
                    <div class="panel-stat">
                        <div class="panel-stat-val">CMS</div>
                        <div class="panel-stat-label">Quản lý nội dung</div>
                    </div>
                    <div class="panel-stat">
                        <div class="panel-stat-val">Tour</div>
                        <div class="panel-stat-label">Lộ trình tham quan</div>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT PANEL -->
        <div class="login-right">
            <div class="login-header">
                <div class="login-title">Chào mừng trở lại!</div>
                <div class="login-subtitle">Đăng nhập để truy cập trang quản trị</div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    @ViewBag.Error
                </div>
            }

            <form method="post" action="/Home/Login">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">Email</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-envelope input-icon"></i>
                        <input type="email" name="email" class="form-input"
                               placeholder="Nhập địa chỉ email..."
                               autocomplete="email" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Mật khẩu</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-lock input-icon"></i>
                        <input type="password" name="password" id="passwordInput" class="form-input"
                               placeholder="Nhập mật khẩu..." autocomplete="current-password" required />
                        <button type="button" class="toggle-pass" onclick="togglePassword()">
                            <i class="fa-solid fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="form-row">
                    <label class="remember-wrap">
                        <input type="checkbox" name="remember" />
                        Ghi nhớ đăng nhập
                    </label>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    Đăng nhập
                </button>
            </form>

            <div class="demo-hint">
                <i class="fa-solid fa-circle-info" style="color:#E85D04;margin-right:5px;"></i>
                <strong>Demo:</strong> email <strong>admin@vkstreetfood.vn</strong> / password <strong>Admin@2026</strong>
            </div>

            <div style="margin-top:14px;font-size:13px;color:#6b7280;">
                Bạn là chủ quán? <a href="/Home/OwnerRegister" style="color:#E85D04;font-weight:600;text-decoration:none;">Đăng ký tài khoản owner</a>
            </div>
        </div>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa-solid fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa-solid fa-eye';
            }
        }
    </script>
</body>
</html>