@{
    ViewData["Title"] = "Đăng ký chủ quán";
    Layout = null;
    var pois = ViewBag.Pois as IEnumerable<VK.Core.Entities.PointOfInterest> ?? new
List<VK.Core.Entities.PointOfInterest>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký chủ quán</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
            body {
                font-family: 'Inter', sans-serif;
                background: #f4f6fb;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                padding: 16px
            }
            .card {
                width: 100%;
                max-width: 560px;
                background: #fff;
                border: 1px solid #e8ebf4;
                border-radius: 16px;
                box-shadow: 0 8px 30px rgba(0, 0, 0, .08);
                padding: 24px
            }
            .title {
                font-size: 22px;
                font-weight: 700;
                color: #1a1d2e;
                margin-bottom: 6px
            }
            .sub {
                font-size: 13px;
                color: #7b819a;
                margin-bottom: 18px
            }
            .group {
                margin-bottom: 12px
            }
            .label {
                display: block;
                font-size: 12px;
                color: #4b5065;
                font-weight: 600;
                margin-bottom: 6px
            }
            .input {
                width: 100%;
                border: 1px solid #d7dcef;
                border-radius: 10px;
                padding: 10px 12px;
                font-size: 14px
            }

            .btn {
                background: #e85d04;
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 11px 16px;
                font-weight: 700;
                cursor: pointer
            }

            .link {
                font-size: 13px;
                color: #e85d04;
                text-decoration: none
            }

            .msg {
                padding: 10px 12px;
                border-radius: 8px;
                font-size: 13px;
                margin-bottom: 12px
            }

            .ok {
                background: #ecfdf3;
                color: #15803d;
                border: 1px solid #bbf7d0
            }

            .err {
                background: #fef2f2;
                color: #dc2626;
                border: 1px solid #fecaca
            }
    </style>
</head>

<body>
    <div class="card">
        <div class="title">Đăng ký tài khoản chủ quán</div>
        <div class="sub">Tài khoản sẽ ở trạng thái <b>pending</b> đến khi admin duyệt.</div>

        @if (TempData["OwnerRegisterSuccess"] != null)
        {
            <div class="msg ok">@TempData["OwnerRegisterSuccess"]</div>
        }
        @if (TempData["OwnerRegisterError"] != null)
        {
            <div class="msg err">@TempData["OwnerRegisterError"]</div>
        }

        <form method="post" action="/Home/OwnerRegister">
            @Html.AntiForgeryToken()
            <div class="group">
                <label class="label">Họ tên</label>
                <input class="input" type="text" name="fullName" required />
            </div>
            <div class="group">
                <label class="label">Email</label>
                <input class="input" type="email" name="email" required />
            </div>
            <div class="group">
                <label class="label">Số điện thoại</label>
                <input class="input" type="text" name="phoneNumber" required />
            </div>
            <div class="group">
                <label class="label">Mật khẩu</label>
                <input class="input" type="password" name="password" required />
            </div>
            <div class="group">
                <label class="label">Quán hiện có (11 quán)</label>
                <select class="input" name="pointOfInterestId" required>
                    <option value="">-- Chọn quán --</option>
                    @foreach (var poi in pois)
                    {
                        <option value="@poi.Id">@poi.Name</option>
                    }
                </select>
            </div>
            <div class="group">
                <label class="label">Ghi chú</label>
                <textarea class="input" name="notes" rows="3"></textarea>
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px;">
                <a class="link" href="/">← Quay lại đăng nhập</a>
                <button class="btn" type="submit">Gửi đăng ký</button>
            </div>
        </form>
    </div>
</body>

</html>