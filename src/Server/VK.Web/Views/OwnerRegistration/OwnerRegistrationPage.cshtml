@{
    ViewData["Title"] = "Duyệt chủ quán";
    Layout = "_AdminLayout";
    var registrations = ViewBag.Registrations as IEnumerable<VK.Core.Entities.PoiOwnerRegistration>
                        ?? new List<VK.Core.Entities.PoiOwnerRegistration>();
    string status = (ViewBag.Status as string) ?? "pending";
}

@if (TempData["Success"] != null)
{
    <div
        style="background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.2);border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#22C55E;font-size:13px;">
        <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div
        style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#EF4444;font-size:13px;">
        <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
    </div>
}

<div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;">
    <div>
        <div class="page-title">Duyệt đăng ký chủ quán</div>
    </div>
</div>

<div class="admin-card">
    <form method="get" action="/OwnerRegistration" class="filter-bar" style="padding:16px 20px 0;">
        <select name="status" style="max-width:220px;">
            <option value="pending" selected="@(status == "pending" ? "selected" : null)">Đang chờ duyệt</option>
            <option value="approved" selected="@(status == "approved" ? "selected" : null)">Đã duyệt</option>
            <option value="rejected" selected="@(status == "rejected" ? "selected" : null)">Đã từ chối</option>
        </select>
        <button type="submit" class="btn-primary-admin" style="padding:8px 14px;">Lọc</button>
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Chủ quán</th>
                    <th>Quán đăng ký</th>
                    <th>Liên hệ</th>
                    <th>Trạng thái</th>
                    <th>Ngày đăng ký</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (registrations.Any())
                {
                    foreach (var item in registrations)
                    {
                        <tr>
                            <td>
                                <div class="item-info">
                                    <div class="table-avatar" style="background:#f97316;">@((item.User.FullName ??
                                                                        "O").Substring(0, 1).ToUpper())</div>
                                        <div>
                                            <div class="item-name">@(item.User.FullName ?? "-")</div>
                                            <div class="item-sub">@item.User.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="item-name">@item.ShopName</div>
                                    <div class="item-sub">@(item.ShopAddress ?? item.PointOfInterest?.Address ?? "-")</div>
                                </td>
                                <td>
                                    <span style="font-size:12px;color:var(--text-secondary);">@(item.ContactPhone ?? "-")</span>
                                </td>
                                <td>
                                    @if (item.Status == "approved")
                                    {
                                        <span class="badge-status badge-active">Approved</span>
                                    }
                                    else if (item.Status == "rejected")
                                    {
                                        <span class="badge-status badge-inactive">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="lang-badge lang-en">Pending</span>
                                    }
                                </td>
                                <td style="font-size:12px;color:var(--text-muted);">
                                    @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (item.Status == "pending")
                                        {
                                            <div style="display:flex;gap:8px;">
                                                <form method="post" action="/OwnerRegistration/Approve" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn-primary-admin"
                                                            style="padding:6px 10px;font-size:12px;">Duyệt</button>
                                                </form>
                                                <form method="post" action="/OwnerRegistration/Reject" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn-secondary-admin"
                                                            style="padding:6px 10px;font-size:12px;">Từ chối</button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-muted);font-size:12px;">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
            else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <i class="fa-solid fa-inbox"></i>
                                        <p>Không có hồ sơ đăng ký.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>