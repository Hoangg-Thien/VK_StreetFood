<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VK.Mobile.ViewModels"
             xmlns:loc="clr-namespace:VK.Mobile.Services"
             x:Class="VK.Mobile.Views.POIDetailPage"
             x:DataType="vm:POIDetailViewModel"
             Shell.NavBarIsVisible="False">

       <ScrollView>
              <StackLayout Padding="0"
                           Spacing="0">

                     <!-- Banner: [back] [title+category] [heart] - full width-->
                     <Grid HeightRequest="60"
                           BackgroundColor="#000000"
                           ColumnDefinitions="56,*,56">

                            <!-- Back button: chevron icon -->
                            <Grid Grid.Column="0"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  WidthRequest="40"
                                  HeightRequest="40">
                                   <Path Data="M 16,8 L 6,20 L 16,32"
                                         Stroke="White"
                                         StrokeThickness="2.5"
                                         StrokeLineCap="Round"
                                         StrokeLineJoin="Round"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"/>
                                   <Grid.GestureRecognizers>
                                          <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                                   </Grid.GestureRecognizers>
                            </Grid>

                            <!-- Title + Category centered -->
                            <StackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="1">
                                   <Label Text="{Binding Poi.Name}"
                                          FontSize="16"
                                          FontAttributes="Bold"
                                          TextColor="White"
                                          HorizontalTextAlignment="Center"
                                          LineBreakMode="TailTruncation"/>
                                   <Label Text="{Binding Poi.CategoryName}"
                                          FontSize="11"
                                          TextColor="White"
                                          HorizontalTextAlignment="Center"
                                          Opacity="0.8"/>
                            </StackLayout>

                            <!-- Heart button -->
                            <Grid Grid.Column="2"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  WidthRequest="40"
                                  HeightRequest="40">
                                   <Label Text="&#x2665;"
                                          TextColor="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                          FontSize="22"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">
                                          <Label.GestureRecognizers>
                                                 <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}"/>
                                          </Label.GestureRecognizers>
                                   </Label>
                            </Grid>
                     </Grid>

                     <!--Image  -->
                     <Image Source="{Binding Poi.ImageUrl}"
                            HeightRequest="200"
                            Aspect="AspectFill"/>

                     <!-- Info Section -->
                     <StackLayout Padding="15"
                                  Spacing="15">

                            <!-- Description -->
                            <Border Padding="15"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#EEEEEE">
                                   <StackLayout Spacing="8">
                                          <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[POIDetailDescription]}"
                                                 FontSize="16"
                                                 FontAttributes="Bold"/>
                                          <Label Text="{Binding Poi.Description}"
                                                 FontSize="14"
                                                 LineBreakMode="WordWrap"/>
                                   </StackLayout>
                            </Border>

                            <!-- Address -->
                            <Border Padding="15"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#EEEEEE">
                                   <StackLayout Spacing="5">
                                          <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[POIDetailAddress]}"
                                                 FontSize="16"
                                                 FontAttributes="Bold"/>
                                          <Label Text="{Binding Poi.Address}"
                                                 FontSize="14"/>
                                   </StackLayout>
                            </Border>

                            <!-- Audio Player Card -->
                            <Border Padding="0"
                                    BackgroundColor="{StaticResource Primary}"
                                    StrokeShape="RoundRectangle 16"
                                    Stroke="Transparent">
                                   <StackLayout Spacing="0">

                                          <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[POIDetailAudioGuide]}"
                                                 FontSize="15"
                                                 FontAttributes="Bold"
                                                 TextColor="White"
                                                 Padding="16,14,16,10"/>

                                          <BoxView HeightRequest="1"
                                                   BackgroundColor="#33FFFFFF"
                                                   Margin="16,0"/>

                                          <StackLayout Padding="16,12,16,4"
                                                       Spacing="4">
                                                 <Slider Minimum="0"
                                                         Maximum="1"
                                                         Value="{Binding AudioPositionRatio}"
                                                         IsEnabled="False"
                                                         ThumbColor="White"
                                                         MinimumTrackColor="White"
                                                         MaximumTrackColor="#66FFFFFF"/>
                                                 <Grid ColumnDefinitions="*,*">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding AudioPositionText}"
                                                               FontSize="11"
                                                               TextColor="#FFCCBC"
                                                               HorizontalOptions="Start"/>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding AudioDurationText}"
                                                               FontSize="11"
                                                               TextColor="#FFCCBC"
                                                               HorizontalOptions="End"/>
                                                 </Grid>
                                          </StackLayout>

                                          <!-- Controls: -5s / play-stop / +5s -->
                                          <Grid ColumnDefinitions="*,Auto,Auto,Auto,*"
                                                ColumnSpacing="16"
                                                Padding="16,8,16,18"
                                                HorizontalOptions="Center">

                                                 <Border Grid.Column="1"
                                                         StrokeShape="Ellipse"
                                                         BackgroundColor="#33FFFFFF"
                                                         StrokeThickness="0"
                                                         WidthRequest="52"
                                                         HeightRequest="52">
                                                        <Border.GestureRecognizers>
                                                               <TapGestureRecognizer Command="{Binding SkipBackAudioCommand}"/>
                                                        </Border.GestureRecognizers>
                                                        <VerticalStackLayout HorizontalOptions="Center"
                                                                             VerticalOptions="Center"
                                                                             Spacing="0">
                                                               <Label Text="&#x25C4;&#x25C4;"
                                                                      TextColor="White"
                                                                      FontSize="13"
                                                                      HorizontalOptions="Center"/>
                                                               <Label Text="-5s"
                                                                      TextColor="#FFCCBC"
                                                                      FontSize="9"
                                                                      HorizontalOptions="Center"/>
                                                        </VerticalStackLayout>
                                                 </Border>

                                                 <Border Grid.Column="2"
                                                         StrokeShape="Ellipse"
                                                         BackgroundColor="White"
                                                         StrokeThickness="0"
                                                         WidthRequest="64"
                                                         HeightRequest="64">
                                                        <Border.GestureRecognizers>
                                                               <TapGestureRecognizer Command="{Binding ToggleAudioCommand}"/>
                                                        </Border.GestureRecognizers>
                                                        <Label FontSize="26"
                                                               TextColor="{StaticResource Primary}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center">
                                                               <Label.Triggers>
                                                                      <DataTrigger TargetType="Label"
                                                                                   Binding="{Binding IsPlayingAudio}"
                                                                                   Value="True">
                                                                             <Setter Property="Text"
                                                                                     Value="&#x25A0;"/>
                                                                      </DataTrigger>
                                                                      <DataTrigger TargetType="Label"
                                                                                   Binding="{Binding IsPlayingAudio}"
                                                                                   Value="False">
                                                                             <Setter Property="Text"
                                                                                     Value="&#x25B6;"/>
                                                                      </DataTrigger>
                                                               </Label.Triggers>
                                                        </Label>
                                                 </Border>

                                                 <Border Grid.Column="3"
                                                         StrokeShape="Ellipse"
                                                         BackgroundColor="#33FFFFFF"
                                                         StrokeThickness="0"
                                                         WidthRequest="52"
                                                         HeightRequest="52">
                                                        <Border.GestureRecognizers>
                                                               <TapGestureRecognizer Command="{Binding SkipForwardAudioCommand}"/>
                                                        </Border.GestureRecognizers>
                                                        <VerticalStackLayout HorizontalOptions="Center"
                                                                             VerticalOptions="Center"
                                                                             Spacing="0">
                                                               <Label Text="&#x25BA;&#x25BA;"
                                                                      TextColor="White"
                                                                      FontSize="13"
                                                                      HorizontalOptions="Center"/>
                                                               <Label Text="+5s"
                                                                      TextColor="#FFCCBC"
                                                                      FontSize="9"
                                                                      HorizontalOptions="Center"/>
                                                        </VerticalStackLayout>
                                                 </Border>

                                          </Grid>
                                   </StackLayout>
                            </Border>

                            <!-- Transcript -->
                            <Border Padding="15"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#EEEEEE"
                                    IsVisible="{Binding HasTranscript}">
                                   <StackLayout Spacing="8">
                                          <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[POIDetailTranscript]}"
                                                 FontSize="15"
                                                 FontAttributes="Bold"
                                                 TextColor="{StaticResource TextPrimary}"/>
                                          <BoxView HeightRequest="1"
                                                   BackgroundColor="{StaticResource Divider}"/>
                                          <Label Text="{Binding AudioTranscript}"
                                                 FontSize="13"
                                                 LineBreakMode="WordWrap"
                                                 TextColor="{StaticResource TextSecondary}"
                                                 LineHeight="1.5"/>
                                   </StackLayout>
                            </Border>

                            <!-- Rating -->
                            <Border Padding="15"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#EEEEEE">
                                   <StackLayout Spacing="10">
                                          <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[POIDetailRating]}"
                                                 FontSize="16"
                                                 FontAttributes="Bold"/>
                                          <FlexLayout Direction="Row"
                                                      JustifyContent="SpaceEvenly">
                                                 <Button Text="1 &#x2B50;"
                                                         Command="{Binding SubmitRatingCommand}"
                                                         CommandParameter="1"
                                                         BackgroundColor="#FFC107"
                                                         TextColor="White"
                                                         CornerRadius="8"/>
                                                 <Button Text="2 &#x2B50;"
                                                         Command="{Binding SubmitRatingCommand}"
                                                         CommandParameter="2"
                                                         BackgroundColor="#FFC107"
                                                         TextColor="White"
                                                         CornerRadius="8"/>
                                                 <Button Text="3 &#x2B50;"
                                                         Command="{Binding SubmitRatingCommand}"
                                                         CommandParameter="3"
                                                         BackgroundColor="#FFC107"
                                                         TextColor="White"
                                                         CornerRadius="8"/>
                                                 <Button Text="4 &#x2B50;"
                                                         Command="{Binding SubmitRatingCommand}"
                                                         CommandParameter="4"
                                                         BackgroundColor="#FFC107"
                                                         TextColor="White"
                                                         CornerRadius="8"/>
                                                 <Button Text="5 &#x2B50;"
                                                         Command="{Binding SubmitRatingCommand}"
                                                         CommandParameter="5"
                                                         BackgroundColor="#FFC107"
                                                         TextColor="White"
                                                         CornerRadius="8"/>
                                          </FlexLayout>
                                          <Label Text="{Binding Poi.AverageRating, StringFormat='Trung b&#236;nh: {0:F1} &#x2B50;'}"
                                                 FontSize="14"
                                                 HorizontalOptions="Center"/>
                                   </StackLayout>
                            </Border>

                            <!-- Vendors -->
                            <Border Padding="15"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#EEEEEE"
                                    IsVisible="{Binding Poi.Vendors.Count, Converter={StaticResource CountToBoolConverter}}">
                                   <StackLayout Spacing="10">
                                          <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[POIDetailVendors]}"
                                                 FontSize="16"
                                                 FontAttributes="Bold"/>
                                          <CollectionView ItemsSource="{Binding Poi.Vendors}">
                                                 <CollectionView.ItemTemplate>
                                                        <DataTemplate>
                                                               <StackLayout Padding="0,5"
                                                                            Spacing="5">
                                                                      <Label Text="{Binding Name}"
                                                                             FontSize="14"
                                                                             FontAttributes="Bold"/>
                                                                      <Label Text="{Binding ContactPhone}"
                                                                             FontSize="12"
                                                                             TextColor="Gray"/>
                                                               </StackLayout>
                                                        </DataTemplate>
                                                 </CollectionView.ItemTemplate>
                                          </CollectionView>
                                   </StackLayout>
                            </Border>

                     </StackLayout>

                     <ActivityIndicator IsRunning="{Binding IsLoading}"
                                        IsVisible="{Binding IsLoading}"
                                        Color="#FF5722"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center"
                                        Margin="0,50,0,0"/>

              </StackLayout>
       </ScrollView>

</ContentPage>