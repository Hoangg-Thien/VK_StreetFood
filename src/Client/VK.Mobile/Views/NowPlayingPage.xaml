<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VK.Mobile.ViewModels"
             xmlns:loc="clr-namespace:VK.Mobile.Services"
             x:Class="VK.Mobile.Views.NowPlayingPage"
             x:DataType="vm:NowPlayingViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#80000000">

    <!-- Full-screen grid: tap overlay to close, card at bottom -->
    <Grid RowDefinitions="*,Auto">

        <!-- Tap outside to close -->
        <Grid Grid.Row="0">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand}"/>
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Bottom Sheet Card -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="0"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 24,24,0,0"
                Padding="0,0,0,0">

            <VerticalStackLayout Spacing="0">

                <!-- Drag Handle -->
                <BoxView WidthRequest="40"
                         HeightRequest="4"
                         CornerRadius="2"
                         Color="#DDDDDD"
                         HorizontalOptions="Center"
                         Margin="0,12,0,0"/>

                <!-- Header: tên POI + nút X -->
                <Grid ColumnDefinitions="*,44"
                      Padding="20,14,12,0">
                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="2">
                        <Label Text="{Binding PoiName}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding PoiCategory}"
                               FontSize="13"
                               TextColor="#FF6B35"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="✕"
                            FontSize="18"
                            TextColor="#888888"
                            BackgroundColor="Transparent"
                            Padding="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Center"
                            Command="{Binding CloseCommand}"/>
                </Grid>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         Color="#F0F0F0"
                         Margin="20,12,20,0"/>

                <!-- Progress Bar + Time -->
                <VerticalStackLayout Padding="20,12,20,0"
                                     Spacing="2">
                    <Slider Minimum="0"
                            Maximum="1"
                            Value="{Binding ProgressRatio}"
                            IsEnabled="False"
                            ThumbColor="#FF6B35"
                            MinimumTrackColor="#FF6B35"
                            MaximumTrackColor="#DDDDDD"/>
                    <Grid ColumnDefinitions="*,*">
                        <Label Grid.Column="0"
                               Text="{Binding ElapsedText}"
                               FontSize="11"
                               TextColor="#AAAAAA"
                               HorizontalOptions="Start"/>
                        <Label Grid.Column="1"
                               Text="{Binding TotalText}"
                               FontSize="11"
                               TextColor="#AAAAAA"
                               HorizontalOptions="End"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Controls -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,*"
                      ColumnSpacing="16"
                      HorizontalOptions="Center"
                      Padding="20,16,20,32"
                      Margin="0,0,0,4">

                    <!-- -5s -->
                    <Border Grid.Column="1"
                            StrokeShape="Ellipse"
                            Stroke="#EEEEEE"
                            BackgroundColor="#F5F5F5"
                            WidthRequest="56"
                            HeightRequest="56">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipBackCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="0">
                            <Label Text="◄◄"
                                   TextColor="#333333"
                                   FontSize="14"
                                   HorizontalOptions="Center"/>
                            <Label Text="-5s"
                                   TextColor="#888888"
                                   FontSize="9"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Stop (big orange) -->
                    <Border Grid.Column="2"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            BackgroundColor="#FF6B35"
                            WidthRequest="68"
                            HeightRequest="68">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding StopCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="■"
                               TextColor="White"
                               FontSize="26"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- +5s -->
                    <Border Grid.Column="3"
                            StrokeShape="Ellipse"
                            Stroke="#EEEEEE"
                            BackgroundColor="#F5F5F5"
                            WidthRequest="56"
                            HeightRequest="56">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipForwardCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="0">
                            <Label Text="►►"
                                   TextColor="#333333"
                                   FontSize="14"
                                   HorizontalOptions="Center"/>
                            <Label Text="+5s"
                                   TextColor="#888888"
                                   FontSize="9"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
