<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VK.Mobile.ViewModels"
             x:Class="VK.Mobile.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False">

       <Grid>
              <!-- Gradient Background -->
              <BoxView>
                     <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                   <GradientStop Color="#FFF27A4F"
                                                 Offset="0.0"/>
                                   <GradientStop Color="#FFF27A4F"
                                                 Offset="1.0"/>
                            </LinearGradientBrush>
                     </BoxView.Background>
              </BoxView>

              <!-- Content -->
              <ScrollView>
                     <VerticalStackLayout VerticalOptions="Center"
                                          Padding="{OnIdiom Phone='24,24,24,16', Tablet='48,48,48,24'}"
                                          Spacing="{OnIdiom Phone=16, Tablet=24}">

                            <!-- App Icon/Logo -->
                            <Border HeightRequest="160"
                                    WidthRequest="160"
                                    HorizontalOptions="Center"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    Shadow="{StaticResource Shadow}">

                                   <Border.Clip>
                                          <EllipseGeometry Center="80,80"
                                                           RadiusX="80"
                                                           RadiusY="80"/>
                                   </Border.Clip>

                                   <Image Source="welcome_logo.png"
                                          HeightRequest="160"
                                          WidthRequest="160"
                                          Aspect="AspectFill"
                                          Scale="1"/>
                            </Border>

                            <!-- App Name -->
                            <Label Text="VK Street Food"
                                   FontSize="{OnIdiom Phone=26, Tablet=34}"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"/>

                            <!-- Tagline -->
                            <Label Text="{Binding Tagline}"
                                   FontSize="{OnIdiom Phone=16, Tablet=18}"
                                   TextColor="White"
                                   Opacity="0.9"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap"
                                   HorizontalTextAlignment="Center"/>

                            <!-- Language Selection -->
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   Spacing="6">
                                   <Button Text="Tiếng Việt"
                                           Command="{Binding SelectLanguageCommand}"
                                           CommandParameter="vi"
                                           BackgroundColor="{Binding ViBackground}"
                                           TextColor="{Binding ViTextColor}"
                                           FontSize="14"
                                           HeightRequest="44"
                                           CornerRadius="20"
                                           Padding="14,8"
                                           BorderColor="White"
                                           BorderWidth="1.5"/>
                                   <Button Text="English"
                                           Command="{Binding SelectLanguageCommand}"
                                           CommandParameter="en"
                                           BackgroundColor="{Binding EnBackground}"
                                           TextColor="{Binding EnTextColor}"
                                           FontSize="14"
                                           HeightRequest="44"
                                           CornerRadius="20"
                                           Padding="14,8"
                                           BorderColor="White"
                                           BorderWidth="1.5"/>
                                   <Button Text="한국어"
                                           Command="{Binding SelectLanguageCommand}"
                                           CommandParameter="ko"
                                           BackgroundColor="{Binding KoBackground}"
                                           TextColor="{Binding KoTextColor}"
                                           FontSize="14"
                                           HeightRequest="44"
                                           CornerRadius="20"
                                           Padding="14,8"
                                           BorderColor="White"
                                           BorderWidth="1.5"/>
                            </HorizontalStackLayout>

                            <!-- Features List -->
                            <VerticalStackLayout Spacing="15"
                                                 Margin="0,20,0,0">
                                   <Grid ColumnDefinitions="Auto,*"
                                         ColumnSpacing="12">
                                          <Label Text="📍"
                                                 FontSize="24"/>
                                          <Label Text="{Binding FeatureLocation}"
                                                 Grid.Column="1"
                                                 TextColor="White"
                                                 FontSize="{OnIdiom Phone=15, Tablet=16}"
                                                 LineBreakMode="WordWrap"
                                                 MaxLines="2"
                                                 HorizontalOptions="Fill"
                                                 VerticalOptions="Center"/>
                                   </Grid>

                                   <Grid ColumnDefinitions="Auto,*"
                                         ColumnSpacing="12">
                                          <Label Text="🎧"
                                                 FontSize="24"/>
                                          <Label Text="{Binding FeatureAudio}"
                                                 Grid.Column="1"
                                                 TextColor="White"
                                                 FontSize="{OnIdiom Phone=15, Tablet=16}"
                                                 LineBreakMode="WordWrap"
                                                 MaxLines="2"
                                                 HorizontalOptions="Fill"
                                                 VerticalOptions="Center"/>
                                   </Grid>

                                   <Grid ColumnDefinitions="Auto,*"
                                         ColumnSpacing="12">
                                          <Label Text="📱"
                                                 FontSize="24"/>
                                          <Label Text="{Binding FeatureQR}"
                                                 Grid.Column="1"
                                                 TextColor="White"
                                                 FontSize="{OnIdiom Phone=15, Tablet=16}"
                                                 LineBreakMode="WordWrap"
                                                 MaxLines="2"
                                                 HorizontalOptions="Fill"
                                                 VerticalOptions="Center"/>
                                   </Grid>
                            </VerticalStackLayout>

                            <!-- Get Started Button -->
                            <Button Text="{Binding GetStartedText}"
                                    Command="{Binding GetStartedCommand}"
                                    BackgroundColor="White"
                                    TextColor="{StaticResource Primary}"
                                    FontSize="{OnIdiom Phone=16, Tablet=18}"
                                    FontAttributes="Bold"
                                    HeightRequest="60"
                                    CornerRadius="28"
                                    Margin="0,22,0,12"
                                    Shadow="{StaticResource Shadow}"/>

                     </VerticalStackLayout>
              </ScrollView>
       </Grid>
</ContentPage>