<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VK.Mobile.ViewModels"
             x:Class="VK.Mobile.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False">

       <Grid>
              <!-- Gradient Background -->
              <BoxView>
                     <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                   <GradientStop Color="#FFF27A4F"
                                                 Offset="0.0"/>
                                   <GradientStop Color="#FFF27A4F"
                                                 Offset="1.0"/>
                            </LinearGradientBrush>
                     </BoxView.Background>
              </BoxView>

              <!-- Content -->
              <VerticalStackLayout VerticalOptions="Center"
                                   Padding="40"
                                   Spacing="30">

                     <!-- App Icon/Logo -->
                     <Border HeightRequest="160"
                             WidthRequest="160"
                             HorizontalOptions="Center"
                             Padding="0"
                             BackgroundColor="Transparent"
                             Shadow="{StaticResource Shadow}">

                            <Border.Clip>
                                   <EllipseGeometry Center="80,80"
                                                    RadiusX="80"
                                                    RadiusY="80"/>
                            </Border.Clip>

                            <Image Source="welcome_logo.png"
                                   HeightRequest="160"
                                   WidthRequest="160"
                                   Aspect="AspectFill"
                                   Scale="1"/>
                     </Border>

                     <!-- App Name -->
                     <Label Text="VK Street Food"
                            FontSize="36"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center"/>

                     <!-- Tagline -->
                     <Label Text="{Binding Tagline}"
                            FontSize="18"
                            TextColor="White"
                            Opacity="0.9"
                            HorizontalTextAlignment="Center"/>

                     <!-- Language Selection -->
                     <HorizontalStackLayout HorizontalOptions="Center"
                                            Spacing="8">
                            <Button Text="Tiếng Việt"
                                    Command="{Binding SelectLanguageCommand}"
                                    CommandParameter="vi"
                                    BackgroundColor="{Binding ViBackground}"
                                    TextColor="{Binding ViTextColor}"
                                    FontSize="13"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    Padding="14,0"
                                    BorderColor="White"
                                    BorderWidth="1.5"/>
                            <Button Text="English"
                                    Command="{Binding SelectLanguageCommand}"
                                    CommandParameter="en"
                                    BackgroundColor="{Binding EnBackground}"
                                    TextColor="{Binding EnTextColor}"
                                    FontSize="13"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    Padding="14,0"
                                    BorderColor="White"
                                    BorderWidth="1.5"/>
                            <Button Text="한국어"
                                    Command="{Binding SelectLanguageCommand}"
                                    CommandParameter="ko"
                                    BackgroundColor="{Binding KoBackground}"
                                    TextColor="{Binding KoTextColor}"
                                    FontSize="13"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    Padding="14,0"
                                    BorderColor="White"
                                    BorderWidth="1.5"/>
                     </HorizontalStackLayout>

                     <!-- Features List -->
                     <VerticalStackLayout Spacing="15"
                                          Margin="0,20,0,0">
                            <HorizontalStackLayout Spacing="15">
                                   <Label Text="📍"
                                          FontSize="24"/>
                                   <Label Text="{Binding FeatureLocation}"
                                          TextColor="White"
                                          FontSize="16"
                                          VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="15">
                                   <Label Text="🎧"
                                          FontSize="24"/>
                                   <Label Text="{Binding FeatureAudio}"
                                          TextColor="White"
                                          FontSize="16"
                                          VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="15">
                                   <Label Text="📱"
                                          FontSize="24"/>
                                   <Label Text="{Binding FeatureQR}"
                                          TextColor="White"
                                          FontSize="16"
                                          VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                     </VerticalStackLayout>

                     <!-- Get Started Button -->
                     <Button Text="{Binding GetStartedText}"
                             Command="{Binding GetStartedCommand}"
                             BackgroundColor="White"
                             TextColor="{StaticResource Primary}"
                             FontSize="18"
                             FontAttributes="Bold"
                             HeightRequest="56"
                             CornerRadius="28"
                             Margin="0,30,0,0"
                             Shadow="{StaticResource Shadow}"/>

              </VerticalStackLayout>
       </Grid>
</ContentPage>