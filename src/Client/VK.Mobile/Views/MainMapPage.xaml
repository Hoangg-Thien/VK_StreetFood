<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VK.Mobile.ViewModels"
             xmlns:loc="clr-namespace:VK.Mobile.Services"
             xmlns:models="clr-namespace:VK.Mobile.Models"
             x:Class="VK.Mobile.Views.MainMapPage"
             x:DataType="vm:MainMapViewModel"
             Title="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[MapTitle]}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top Bar -->
        <Grid Grid.Row="0"
              Padding="10"
              BackgroundColor="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[MapTitle]}"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="Black"
                   VerticalOptions="Center"/>

            <Picker Grid.Column="1"
                    Title="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Language]}"
                    SelectedIndex="{Binding SelectedLanguageIndex}"
                    TextColor="Black"
                    TitleColor="Black"
                    WidthRequest="130"
                    Margin="10,0">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Tiếng Việt</x:String>
                        <x:String>English</x:String>
                        <x:String>한국어</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Grid>

        <!-- Map + POI List -->
        <Grid Grid.Row="1">
            <!-- Map Container -->
            <ContentView x:Name="MapContainer"/>

            <!-- Map Control Buttons (zoom + locate) -->
            <VerticalStackLayout HorizontalOptions="End"
                                 VerticalOptions="Center"
                                 Spacing="2"
                                 Margin="0,0,10,0">
                <!-- Zoom In -->
                <Border BackgroundColor="#CC1A1A1A"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent"
                        WidthRequest="36"
                        HeightRequest="36">
                    <Button Text="+"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Padding="0"
                            Clicked="OnZoomInClicked"/>
                </Border>
                <!-- Divider -->
                <BoxView HeightRequest="1"
                         Color="#555"
                         Margin="6,0"/>
                <!-- Zoom Out -->
                <Border BackgroundColor="#CC1A1A1A"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent"
                        WidthRequest="36"
                        HeightRequest="36">
                    <Button Text="−"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Padding="0"
                            Clicked="OnZoomOutClicked"/>
                </Border>
                <!-- Locate Me -->
                <Border BackgroundColor="#CCFF6B35"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent"
                        WidthRequest="36"
                        HeightRequest="36"
                        Margin="0,8,0,0">
                    <Button Text="➤"
                            FontSize="18"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Padding="0"
                            Clicked="OnLocateMeClicked"/>
                </Border>

                <!-- Clear current route -->
                <Border x:Name="ClearRouteBorder"
                        BackgroundColor="#D9DE0000"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent"
                        WidthRequest="36"
                        HeightRequest="36"
                        Margin="0,8,0,0"
                        IsVisible="False">
                    <Button Text="✕"
                            FontSize="16"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Padding="0"
                            Clicked="OnClearRouteClicked"/>
                </Border>

                <Border BackgroundColor="#D9DE0000"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent"
                        WidthRequest="36"
                        HeightRequest="36"
                        Margin="0,8,0,0"
                        IsVisible="{Binding HasRunningTour}">
                    <Button Text="✕"
                            FontSize="16"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Padding="0"
                            Command="{Binding ExitActiveTourCommand}"/>
                </Border>
            </VerticalStackLayout>

            <!-- API Error Banner (top of map) -->
            <Frame VerticalOptions="Start"
                   HorizontalOptions="Fill"
                   Margin="8,8,8,0"
                   Padding="8,6"
                   BackgroundColor="#FFF3E0"
                   BorderColor="#FF8C00"
                   CornerRadius="8"
                   HasShadow="False"
                   IsVisible="{Binding HasPoiError}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="{Binding PoiLoadError}"
                           FontSize="11"
                           TextColor="#E65100"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[MenuRetry]}"
                            FontSize="11"
                            BackgroundColor="#FF5722"
                            TextColor="White"
                            CornerRadius="6"
                            Padding="8,4"
                            HeightRequest="32"
                            Command="{Binding LoadPOIsCommand}"/>
                </Grid>
            </Frame>

            <!-- POI List Drawer (Bottom) -->
            <Frame VerticalOptions="End"
                   Margin="8,0,8,8"
                   Padding="0"
                   CornerRadius="12"
                   BackgroundColor="White"
                   HasShadow="True"
                   MaximumHeightRequest="150"
                   IsVisible="{Binding HasPOIs}">
                <VerticalStackLayout>
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[POIListTitle]}"
                           FontSize="14"
                           FontAttributes="Bold"
                           Padding="12,8,12,4"
                           TextColor="#333"/>
                    <CollectionView ItemsSource="{Binding Pois}"
                                    HeightRequest="150">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:POIModel">
                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="12,6"
                                      ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#333"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Address}"
                                               FontSize="11"
                                               TextColor="#888"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="🔊"
                                            FontSize="18"
                                            BackgroundColor="#FF5722"
                                            TextColor="White"
                                            CornerRadius="20"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainMapViewModel}}, Path=TestAudioCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#FF5722"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>

        <!-- Bottom Info Bar -->
        <Grid Grid.Row="2"
              Padding="10"
              BackgroundColor="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Text="📍"
                   FontSize="24"
                   VerticalOptions="Center"/>

            <StackLayout Grid.Column="1"
                         Spacing="2"
                         Margin="10,0">
                <Label FontSize="14"
                       FontAttributes="Bold">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[POIsLabel]}"/>
                            <Span Text=": "/>
                            <Span Text="{Binding Pois.Count}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label FontSize="12"
                       TextColor="Gray">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[NearbyLabel]}"/>
                            <Span Text=": "/>
                            <Span Text="{Binding NearbyPOIs.Count}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </StackLayout>

            <Frame Grid.Column="2"
                   Padding="8,4"
                   BackgroundColor="{Binding IsTracking, Converter={StaticResource BoolToColorConverter}}"
                   CornerRadius="12"
                   HasShadow="False">
                <Label Text="{Binding IsTracking, Converter={StaticResource BoolToTrackingTextConverter}}"
                       TextColor="White"
                       FontSize="12"/>
            </Frame>
        </Grid>

        <!-- POI Bottom Card (hiện khi bấm marker trên map) -->
        <Grid x:Name="POIBottomCard"
              Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="False">
            <!-- Backdrop trong suốt: bấm ngoài card để đóng -->
            <BoxView BackgroundColor="Transparent"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCardBackdropTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Card nổi ở phía dưới -->
            <Frame Margin="10,0,10,14"
                   Padding="14"
                   CornerRadius="16"
                   BackgroundColor="White"
                   HasShadow="True"
                   VerticalOptions="End">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="14">

                    <!-- Hàng 1: Ảnh + thông tin + nút đóng -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="84,*,36"
                          ColumnSpacing="12">

                        <!-- Ảnh thumbnail -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                BackgroundColor="#F0F0F0"
                                WidthRequest="84"
                                HeightRequest="84">
                            <Image x:Name="POICardImage"
                                   Aspect="AspectFill"
                                   WidthRequest="84"
                                   HeightRequest="84"/>
                        </Border>

                        <!-- Tên + loại + khoảng cách -->
                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="3">
                            <Label x:Name="POICardName"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2"/>
                            <Label x:Name="POICardCategory"
                                   FontSize="12"
                                   TextColor="#888"/>
                            <Label x:Name="POICardDistance"
                                   FontSize="13"
                                   TextColor="#FF5722"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <!-- Nút đóng -->
                        <Button Grid.Column="2"
                                Text="✕"
                                FontSize="14"
                                TextColor="#999"
                                BackgroundColor="Transparent"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                VerticalOptions="Start"
                                Clicked="OnCardCloseTapped"/>
                    </Grid>

                    <!-- Hàng 2: Nút hành động -->
                    <Grid Grid.Row="1"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="8">
                        <!-- Nghe thuyết minh: nút chính toàn chiều rộng -->
                        <Button Grid.Row="0"
                                Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[MainMapButtonListen]}"
                                FontSize="14"
                                FontAttributes="Bold"
                                BackgroundColor="#FF5722"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="52"
                                Clicked="OnPOIListenClicked"/>
                        <!-- Xem chi tiết + Chỉ đường -->
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[MainMapButtonDetail]}"
                                    FontSize="13"
                                    BackgroundColor="#FFF3E0"
                                    TextColor="#FF5722"
                                    CornerRadius="10"
                                    HeightRequest="48"
                                    Clicked="OnPOIDetailClicked"/>
                            <Button Grid.Column="1"
                                    Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[MainMapButtonDirections]}"
                                    FontSize="13"
                                    BackgroundColor="#E3F2FD"
                                    TextColor="#1565C0"
                                    CornerRadius="10"
                                    HeightRequest="48"
                                    Clicked="OnPOIDirectionsClicked"/>
                        </Grid>
                    </Grid>

                </Grid>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
