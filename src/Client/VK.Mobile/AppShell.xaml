<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VK.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VK.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{StaticResource TabBarBackground}"
    Shell.TabBarForegroundColor="#FFFF6B35"
    Shell.TabBarUnselectedColor="{StaticResource TabBarUnselected}">

    <!-- Welcome Page (No TabBar) -->
    <ShellContent
        Route="Welcome"
        ContentTemplate="{DataTemplate local:WelcomePage}"
        Shell.TabBarIsVisible="False"
        Shell.NavBarIsVisible="False"/>

    <!-- Main TabBar -->
    <TabBar>
        <!-- Bản đồ -->
        <ShellContent
            x:Name="TabMap"
            Title="Bản đồ"
            Route="MainMap"
            ContentTemplate="{DataTemplate local:MainMapPage}"
            Shell.NavBarIsVisible="False">
            <ShellContent.Icon>
                <FontImageSource Glyph="🗺️"
                                 Size="22"/>
            </ShellContent.Icon>
        </ShellContent>

        <!-- Khám phá (Menu POI) -->
        <ShellContent
            x:Name="TabMenu"
            Title="Khám phá"
            Route="Menu"
            ContentTemplate="{DataTemplate local:MenuPage}"
            Shell.NavBarIsVisible="False">
            <ShellContent.Icon>
                <FontImageSource Glyph="🍜"
                                 Size="22"/>
            </ShellContent.Icon>
        </ShellContent>

        <!-- Yêu thích -->
        <ShellContent
            x:Name="TabFavorites"
            Title="Yêu thích"
            Route="Favorites"
            ContentTemplate="{DataTemplate local:FavoritesPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="❤️"
                                 Size="22"/>
            </ShellContent.Icon>
        </ShellContent>

        <!-- Hồ sơ -->
        <ShellContent
            x:Name="TabProfile"
            Title="Hồ sơ"
            Route="Profile"
            ContentTemplate="{DataTemplate local:ProfilePage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="👤"
                                 Size="22"/>
            </ShellContent.Icon>
        </ShellContent>

        <!-- Cài đặt -->
        <ShellContent
            x:Name="TabSettings"
            Title="Cài đặt"
            Route="Settings"
            ContentTemplate="{DataTemplate local:SettingsPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="⚙️"
                                 Size="22"/>
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>